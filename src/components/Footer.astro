---
import type { PageKey } from "@/lib/whatsapp";
import { BRAND, LOGO_URL, getTagline, WHATSAPP_DISPLAY } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import HoursWidget from "@/components/HoursWidget.astro";
import type { Locale } from "@/lib/i18n";
import { routeFor } from "@/lib/routes";

type Props = { page: PageKey; locale?: Locale };
const { page, locale = "es" } = Astro.props;
const wa = getWhatsAppLink(page, locale);
const tagline = getTagline(locale);
const t = {
  pitch:
    locale === "en"
      ? "Premium websites, community systems, and automations with a focus on security, clarity, and performance. No hacks, spam, or unauthorized access."
      : "Web premium, sistemas de comunidad y automatizaciones con enfoque en seguridad, claridad y performance.\n          No hacemos hacks, spam ni accesos no autorizados.",
  quote: locale === "en" ? "Get a quote on WhatsApp" : "Cotizar por WhatsApp",
  security: locale === "en" ? "Security & ethics" : "Seguridad y etica",
  services: locale === "en" ? "Services" : "Servicios",
  explore: locale === "en" ? "Explore" : "Explora",
  contact: locale === "en" ? "Contact" : "Contacto",
  schedule: locale === "en" ? "Schedule a call" : "Agendar llamada",
  web: locale === "en" ? "Web / UI-UX" : "Web / UI-UX",
  discord: "Discord",
  minecraft: "Minecraft",
  waAi: locale === "en" ? "WhatsApp + AI" : "WhatsApp + IA",
  portfolio: locale === "en" ? "Portfolio" : "Portafolio",
  pricing: locale === "en" ? "Pricing" : "Precios",
  about: locale === "en" ? "About Vexora" : "Sobre Vexora",
  hours: locale === "en" ? "Hours (CDMX base)" : "Horario (base CDMX)",
  hoursLine:
    locale === "en"
      ? "Mon–Fri 07:00–23:00 · Sat 10:00–20:00 · Sun closed"
      : "Lun-Vie 07:00-23:00 · Sáb 10:00-20:00 · Dom cerrado",
  footer1:
    locale === "en"
      ? `© ${new Date().getFullYear()} ${BRAND}. Built for performance, SEO, and accessibility.`
      : `© ${new Date().getFullYear()} ${BRAND}. Hecho para performance, SEO y accesibilidad.`,
  footer2:
    locale === "en"
      ? "Privacy: we keep the minimum needed to quote and support you."
      : "Privacidad: guardamos lo minimo necesario para cotizar y dar soporte."
};
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand glass">
        <div class="footer__brandHead">
          <img class="mark" src={LOGO_URL} alt="" aria-hidden="true" loading="lazy" decoding="async" />
          <div>
            <div class="name">{BRAND}</div>
            <div class="tag muted">{tagline}</div>
          </div>
        </div>
        <p class="muted">{t.pitch}</p>
        <div class="footer__ctaRow">
          <a class="btn btn-primary" href={wa} target="_blank" rel="noreferrer">{t.quote}</a>
          <a class="btn" href={routeFor("seguridad", locale)}>{t.security}</a>
        </div>
      </div>

      <div class="footer__cols">
        <div class="glass footer__col">
          <div class="colTitle">{t.services}</div>
          <a class="colLink" href={routeFor("web", locale)}>{t.web}</a>
          <a class="colLink" href={routeFor("discord", locale)}>{t.discord}</a>
          <a class="colLink" href={routeFor("minecraft", locale)}>{t.minecraft}</a>
          <a class="colLink" href={routeFor("whatsapp", locale)}>{t.waAi}</a>
        </div>
        <div class="glass footer__col">
          <div class="colTitle">{t.explore}</div>
          <a class="colLink" href={routeFor("portafolio", locale)}>{t.portfolio}</a>
          <a class="colLink" href={routeFor("precios", locale)}>{t.pricing}</a>
          <a class="colLink" href={routeFor("faq", locale)}>FAQ</a>
          <a class="colLink" href={routeFor("sobre", locale)}>{t.about}</a>
        </div>
        <div class="glass footer__col">
          <div class="colTitle">{t.contact}</div>
          <div class="muted small">WhatsApp</div>
          <a class="colLink" href={wa} target="_blank" rel="noreferrer">{WHATSAPP_DISPLAY}</a>
          <a class="colLink" href={routeFor("agenda", locale)} data-track="open_agenda">{t.schedule}</a>
          <div class="muted small" style="margin-top:10px;">{t.hours}</div>
          <div class="muted small">{t.hoursLine}</div>
        </div>
      </div>
    </div>

    <div class="footer__hours">
      <HoursWidget />
    </div>

    <div class="footer__bottom">
      <div class="muted small">{t.footer1}</div>
      <div class="muted small">{t.footer2}</div>
    </div>
  </div>
</footer>

<style>
  .footer{
    padding-block: 64px 40px;
  }
  .footer__inner{ display:grid; gap:24px; }
  .footer__top{
    display:grid;
    grid-template-columns: 1.1fr .9fr;
    gap:18px;
  }
  .footer__brand{
    padding:22px;
  }
  .footer__brandHead{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:10px;
  }
  .mark{
    width:40px;
    height:40px;
    display:grid;
    place-items:center;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.14);
    background: linear-gradient(180deg, rgba(139,92,255,.20), rgba(255,255,255,.04));
    object-fit:cover;
  }
  .name{
    font-family: var(--font-display);
    font-weight:600;
    letter-spacing:-.02em;
  }
  .tag{ font-size: 13px; }
  .footer__ctaRow{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 14px; }

  .footer__cols{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap:12px;
  }
  .footer__col{ padding:18px; }
  .colTitle{
    font-family: var(--font-display);
    font-weight:600;
    margin-bottom:10px;
  }
  .colLink{
    display:block;
    padding:8px 10px;
    border-radius: 12px;
    border:1px solid transparent;
    color: rgba(237,237,243,.86);
  }
  .colLink:hover{
    border-color: rgba(255,255,255,.12);
    background: rgba(255,255,255,.04);
  }
  .small{ font-size: 13px; }

  .footer__hours{ }

  .footer__bottom{
    display:flex;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  @media (max-width: 980px){
    .footer__top{ grid-template-columns:1fr; }
    .footer__cols{ grid-template-columns:1fr; }
  }
</style>

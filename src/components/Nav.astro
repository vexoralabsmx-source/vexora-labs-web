---
import { BRAND, LOGO_URL } from "@/lib/constants";
import { getNav } from "@/lib/nav";
import { routeFor } from "@/lib/routes";
import { getWhatsAppLink, type PageKey } from "@/lib/whatsapp";
import type { Locale } from "@/lib/i18n";
import { otherLocale } from "@/lib/i18n";

type Props = { page: PageKey; locale?: Locale };
const { page, locale = "es" } = Astro.props;
const wa = getWhatsAppLink(page, locale);
const NAV = getNav(locale);
const homeHref = routeFor("home", locale);
const langHref = routeFor(page, otherLocale(locale));
const t = {
  home: locale === "en" ? "Home" : "Inicio",
  navLabel: locale === "en" ? "Main navigation" : "Navegacion principal",
  openMenu: locale === "en" ? "Open menu" : "Abrir menu",
  brandAria: locale === "en" ? `${BRAND} - Home` : `${BRAND} - Inicio`,
  quote: locale === "en" ? "Get a quote on WhatsApp" : "Cotizar por WhatsApp",
  langAria: locale === "en" ? "Cambiar a Español" : "Switch to English",
  langLabel: locale === "en" ? "ES" : "EN"
};
---
<header class="nav" role="banner">
  <div class="container nav__inner">
    <a class="brand" href={homeHref} aria-label={t.brandAria}>
      <img class="brand__mark" src={LOGO_URL} alt="" aria-hidden="true" loading="eager" decoding="async" />
      <span class="brand__text">{BRAND}</span>
    </a>

    <button class="menuBtn" type="button" aria-label={t.openMenu} aria-expanded="false" data-menu-btn>
      <span class="menuBtn__bar"></span>
      <span class="menuBtn__bar"></span>
    </button>

    <nav class="menu" aria-label={t.navLabel} data-menu>
      <a class={`menu__link ${page === "home" ? "is-active" : ""}`} href={homeHref}>{t.home}</a>
      {NAV.map((item) => (
        <a class={`menu__link ${page === item.key ? "is-active" : ""}`} href={item.href}>
          {item.label}
        </a>
      ))}
      <a class="menu__link lang" href={langHref} aria-label={t.langAria}>{t.langLabel}</a>
      <a class="btn btn-primary menu__cta" href={wa} target="_blank" rel="noreferrer">{t.quote}</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function(){
    const btn = document.querySelector("[data-menu-btn]");
    const menu = document.querySelector("[data-menu]");
    if(!btn || !menu) return;

    const close = () => {
      btn.setAttribute("aria-expanded","false");
      menu.classList.remove("is-open");
    };
    const toggle = () => {
      const isOpen = menu.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    };

    btn.addEventListener("click", toggle);
    window.addEventListener("keydown", (e) => {
      if(e.key === "Escape") close();
    });
    window.addEventListener("resize", () => {
      if(window.matchMedia("(min-width: 980px)").matches) close();
    });
  })();
</script>

<style>
  .nav{
    position:sticky;
    top:0;
    z-index:50;
    border-bottom:1px solid rgba(255,255,255,.10);
    background: linear-gradient(180deg, rgba(7,7,11,.72), rgba(7,7,11,.38));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .nav__inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding-block:14px;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:10px;
    min-width:max-content;
  }
  .brand__mark{
    width:34px;
    height:34px;
    display:grid;
    place-items:center;
    border-radius:12px;
    border:1px solid rgba(255,255,255,.14);
    background: linear-gradient(180deg, rgba(139,92,255,.20), rgba(255,255,255,.04));
    box-shadow: 0 12px 40px rgba(139,92,255,.16);
    object-fit:cover;
  }
  .brand__text{
    font-family: var(--font-display);
    font-weight:600;
    letter-spacing:-.02em;
  }

  .menuBtn{
    display:none;
    border:1px solid var(--stroke);
    background: rgba(255,255,255,.04);
    border-radius: 999px;
    padding:10px 12px;
    align-items:center;
    justify-content:center;
    gap:6px;
  }
  .menuBtn__bar{
    width:18px;
    height:2px;
    border-radius:99px;
    background: rgba(237,237,243,.85);
    display:block;
  }

  .menu{
    display:flex;
    align-items:center;
    gap:14px;
  }
  .menu__link{
    color: rgba(237,237,243,.82);
    padding:10px 10px;
    border-radius: 999px;
    border:1px solid transparent;
    transition: border-color .18s ease, background .18s ease;
    font-size: 14px;
  }
  .menu__link.lang{
    border-color: rgba(255,255,255,.12);
    background: rgba(255,255,255,.03);
  }
  .menu__link:hover{
    border-color: rgba(255,255,255,.14);
    background: rgba(255,255,255,.04);
  }
  .menu__link.is-active{
    border-color: rgba(139,92,255,.35);
    background: linear-gradient(180deg, rgba(139,92,255,.18), rgba(255,255,255,.03));
  }
  .menu__cta{ margin-left: 8px; }

  @media (max-width: 980px){
    .menuBtn{ display:inline-flex; }
    .menu{
      position:absolute;
      left:0;
      right:0;
      top:100%;
      padding:14px;
      display:grid;
      gap:10px;
      background: rgba(7,7,11,.78);
      border-bottom:1px solid rgba(255,255,255,.10);
      transform: translateY(-6px);
      opacity:0;
      pointer-events:none;
      transition: transform .18s ease, opacity .18s ease;
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    .menu.is-open{
      transform: translateY(0);
      opacity:1;
      pointer-events:auto;
    }
    .menu__cta{ width:100%; justify-content:center; }
  }
</style>

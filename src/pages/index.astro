---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { getServices } from "@/lib/services";
import { getFeaturedPricing, PRICING_NOTE } from "@/lib/pricing";
import { CASE_STUDIES } from "@/lib/caseStudies";
import { formatMoneyFromMXN } from "@/lib/currency";

const services = getServices("es");
const featuredPricing = getFeaturedPricing("es", 4);
const projects = CASE_STUDIES;
const waHome = getWhatsAppLink("home");
const faqItems = [
  {
    q: "Cuanto tarda una web?",
    a: "Una landing starter suele tardar 5 a 8 dias habiles. Una landing premium puede tomar 8 a 12 dias y una web multipagina normalmente va de 12 a 18 dias, segun contenido e integraciones."
  },
  {
    q: "Puedo pedir cambios?",
    a: "Si. Definimos rondas de revision desde el inicio para ajustar estructura, copy y detalles visuales sin perder orden."
  },
  {
    q: "Los precios son fijos?",
    a: "Son precios desde. El monto final depende del alcance, urgencia, numero de pantallas, funciones, integraciones y nivel de personalizacion."
  },
  {
    q: "Trabajan con negocios pequenos?",
    a: "Si. Vexora Labs esta pensado para emprendedores, negocios pequenos, creadores y comunidades que quieren verse profesionales sin presupuestos enormes."
  },
  {
    q: "Hacen bots de Discord personalizados?",
    a: "Si. Podemos crear tickets, logs, embeds, roles, comandos, moderacion y automatizaciones segun el flujo de tu comunidad."
  },
  {
    q: "Configuran servidores de Minecraft?",
    a: "Si. Configuramos plugins, rangos, permisos, economia, lobby simple, backups y optimizacion basica segun el tipo de servidor."
  },
  {
    q: "Pueden mejorar una web que ya tengo?",
    a: "Si. Hacemos auditoria visual, redisenamos secciones, mejoramos mobile, jerarquia, copy, CTA y estructura de conversion."
  },
  {
    q: "Puedo pagar por partes?",
    a: "En muchos proyectos si. Normalmente trabajamos con anticipo y liquidacion contra entrega o por hitos, segun el alcance."
  },
  {
    q: "Incluye dominio y hosting?",
    a: "No por defecto. Podemos ayudarte a elegirlos y configurarlos; los costos de proveedor se cotizan aparte."
  },
  {
    q: "Dan soporte despues de entregar?",
    a: "Si. Puedes contratar soporte mensual opcional para mantenimiento, ajustes menores, monitoreo basico y prioridad de respuesta."
  }
];
const heroStats = [
  { k: "Desde", v: "$1,499 MXN", d: "paquetes de entrada" },
  { k: "Hasta", v: "$20,000+ MXN", d: "proyectos elite" },
  { k: "Entrega", v: "5 dias+", d: "segun alcance" }
];
const impactCards = [
  {
    title: "Se entiende rapido que vendes",
    text: "Jerarquia, copy y CTAs para que el visitante no tenga que adivinar tu oferta."
  },
  {
    title: "Tu marca deja de parecer improvisada",
    text: "UI premium, consistencia visual y secciones de confianza desde el primer scroll."
  },
  {
    title: "Cotizar se vuelve facil",
    text: "Precios desde, paquetes claros y caminos directos a WhatsApp o brief."
  },
  {
    title: "Puedes crecer por etapas",
    text: "Empezamos con lo esencial y dejamos estructura para web, bot, tienda o automatizacion."
  }
];
const budgetLanes = [
  { name: "Starter", price: "$1,499-$3,499", text: "Branding, bot basico, Minecraft basico o landing starter." },
  { name: "Pro", price: "$4,999-$6,999", text: "Rediseno, bot pro o landing premium con mejor storytelling." },
  { name: "Premium", price: "$9,999-$14,999", text: "Web multipagina, tienda basica o automatizacion profesional." },
  { name: "Elite", price: "$17,999-$20,000+", text: "Web + bot + automatizacion o proyecto digital completo." }
];
const serviceIconMap: Record<string, string> = {
  web: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16v11H4z"/><path d="M4 10h16"/><path d="M8 14h4"/><path d="M15 14h2"/></svg>',
  commerce: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h15l-2 8H8z"/><path d="M6 8 5.4 5H3"/><path d="M9 20h.01"/><path d="M18 20h.01"/></svg>',
  discord: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8.5c3.2-1.4 6.8-1.4 10 0l1 7c-2.7 2-9.3 2-12 0z"/><path d="M9 13h.01"/><path d="M15 13h.01"/><path d="M9.5 16c1.6.7 3.4.7 5 0"/></svg>',
  minecraft: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5z"/><path d="M5 10h14"/><path d="M10 5v14"/><path d="M14 10v9"/></svg>',
  automations: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h4v4H7z"/><path d="M13 13h4v4h-4z"/><path d="M11 9h3a3 3 0 0 1 3 3v1"/><path d="M13 15h-3a3 3 0 0 1-3-3v-1"/></svg>',
  branding: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 4 8l8 4 8-4z"/><path d="M4 12l8 4 8-4"/><path d="M4 16l8 4 8-4"/></svg>'
};
---
<BaseLayout
  page="home"
  title={`${BRAND} | Webs, bots y soluciones digitales premium`}
  description="Creamos paginas web, tiendas online, bots de Discord, servidores de Minecraft y automatizaciones con diseno premium, precios accesibles y enfoque en resultados."
  canonicalPath="/"
>
  <section class="section hero" id="inicio">
    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="pill" data-reveal>
          <span class="pillDot" aria-hidden="true"></span>
          <span>Agencia digital premium para negocios, creadores y comunidades</span>
        </div>
        <h1 class="h1 hero__title" data-reveal>
          Creamos webs, bots y sistemas digitales que hacen ver premium a tu marca
        </h1>
        <p class="hero__lead muted" data-reveal>
          En Vexora Labs disenamos paginas web, tiendas online, bots de Discord, servidores de Minecraft y automatizaciones con una estetica moderna, rapida y lista para vender.
        </p>
        <div class="hero__cta" data-reveal>
          <a class="btn btn-primary" href={waHome} target="_blank" rel="noreferrer">Cotizar mi proyecto</a>
          <a class="btn" href="#servicios">Ver servicios</a>
          <a class="btn" href="#precios">Ver precios</a>
        </div>
        <div class="badgeRow" data-reveal>
          {["Webs modernas", "Bots de Discord", "Automatizaciones", "UI/UX premium", "Precios accesibles"].map((badge) => (
            <span>{badge}</span>
          ))}
        </div>
        <div class="heroStats" data-reveal>
          {heroStats.map((stat) => (
            <div class="heroStat">
              <span>{stat.k}</span>
              <strong>{stat.v}</strong>
              <small>{stat.d}</small>
            </div>
          ))}
        </div>
      </div>

      <aside class="heroPanel glass" aria-label="Vista rapida de Vexora Labs" data-reveal>
        <div class="heroPanel__top">
          <div>
            <div class="heroPanel__eyebrow">Launch console</div>
            <div class="heroPanel__title">Tu proyecto se ve premium antes de vender.</div>
          </div>
          <div class="statusPill">Cotizable</div>
        </div>
        <div class="console">
          <div class="console__header">
            <span>Vexora build plan</span>
            <strong>Premium / Accesible</strong>
          </div>
          <div class="console__screen">
            <div class="console__row is-on">
              <span>Oferta clara</span>
              <strong>Lista</strong>
            </div>
            <div class="console__row is-on">
              <span>UI responsive</span>
              <strong>Mobile-first</strong>
            </div>
            <div class="console__row">
              <span>CTA y precios</span>
              <strong>Visibles</strong>
            </div>
            <div class="console__row">
              <span>Entrega</span>
              <strong>Por alcance</strong>
            </div>
          </div>
          <div class="console__rail">
            {services.slice(0, 4).map((service) => (
              <a href="#servicios">
                <span>{service.title}</span>
                <strong>{formatMoneyFromMXN(service.priceFromMXN, "MXN")}</strong>
              </a>
            ))}
          </div>
        </div>
        <div class="heroPanel__note">
          Diseno profesional sin presupuestos enormes. Alcance claro, entregables reales y soporte directo por WhatsApp o Discord.
        </div>
      </aside>
    </div>
  </section>

  <section class="section story">
    <div class="container story__grid">
      <div class="story__headline" data-reveal>
        <div class="pill">Tu idea no necesita verse barata para empezar</div>
        <h2 class="h2">Convertimos ideas buenas en experiencias digitales modernas, claras y funcionales.</h2>
      </div>
      <div class="storyCards">
        <article class="storyCard glass" data-reveal>
          <span>01</span>
          <h3>El problema</h3>
          <p class="muted">Muchos negocios, creadores y comunidades tienen una idea fuerte, pero su web, servidor o sistema se ve improvisado, lento o poco confiable.</p>
        </article>
        <article class="storyCard glass" data-reveal>
          <span>02</span>
          <h3>La solucion</h3>
          <p class="muted">Vexora Labs estructura, disena y desarrolla soluciones digitales con estetica premium, copy claro y funcionamiento real.</p>
        </article>
        <article class="storyCard glass" data-reveal>
          <span>03</span>
          <h3>El resultado</h3>
          <p class="muted">Una marca mas profesional, confiable, mejor presentada y lista para vender, organizar o crecer.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section impact">
    <div class="container">
      <div class="impactBand glass" data-reveal>
        <div>
          <div class="pill">Lo que mejora</div>
          <h2 class="h2">Tu presencia digital empieza a trabajar a favor de tu marca.</h2>
        </div>
        <div class="impactGrid">
          {impactCards.map((card) => (
            <article class="impactCard">
              <h3>{card.title}</h3>
              <p class="muted">{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="servicios">
    <div class="container">
      <div class="sectionHead" data-reveal>
        <div>
          <div class="pill">Servicios principales</div>
          <h2 class="h2">Webs, bots y sistemas pensados para vender, organizar y crecer.</h2>
        </div>
        <a class="btn" href="/servicios/">Ver todos los servicios</a>
      </div>
      <div class="serviceGrid">
        {services.map((service) => (
          <article class="serviceCard glass" data-reveal>
            <div class="serviceCard__top">
              <div class={`serviceIcon serviceIcon--${service.category}`} aria-hidden="true" set:html={serviceIconMap[service.category]}></div>
              <div class="servicePrice">Desde {formatMoneyFromMXN(service.priceFromMXN, "MXN")}</div>
            </div>
            <h3>{service.title}</h3>
            <p class="muted">{service.summary}</p>
            <ul>
              {service.bullets.map((item) => <li>{item}</li>)}
            </ul>
            <div class="serviceCard__foot">
              <span>{service.estimatedTime}</span>
              <a href={waHome} target="_blank" rel="noreferrer">Cotizar</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="precios">
    <div class="container">
      <div class="sectionHead" data-reveal>
        <div>
          <div class="pill">Precios claros</div>
          <h2 class="h2">Precios accesibles para empezar profesional.</h2>
          <p class="muted sectionLead">{PRICING_NOTE}</p>
        </div>
        <a class="btn btn-primary" href="/precios/">Ver paquetes completos</a>
      </div>
      <div class="pricingGrid">
        {featuredPricing.map((tier) => (
          <article class="priceCard glass" data-reveal>
            <div class="priceCard__badge">{tier.badge}</div>
            <h3>{tier.name}</h3>
            <div class="priceCard__price">
              Desde {formatMoneyFromMXN(tier.priceOneTimeMXN, "MXN")}{tier.priceOneTimeSuffix ?? ""}
            </div>
            <p class="muted">{tier.description}</p>
            <ul>
              {tier.includes.slice(0, 5).map((item) => <li>{item}</li>)}
            </ul>
            <div class="priceCard__actions">
              <a class="btn btn-primary" href={waHome} target="_blank" rel="noreferrer" data-choose-package={tier.id}>Cotizar este paquete</a>
              <a class="btn" href="/precios/">Ver que incluye</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="budgetBand glass" data-reveal>
        <div class="budgetBand__copy">
          <div class="pill">Rutas por presupuesto</div>
          <h2 class="h2">Empieza pequeno, pero no te veas pequeno.</h2>
          <p class="muted">La estrategia es simple: arrancar con una base profesional y escalar cuando el proyecto ya necesita mas pantallas, integraciones o automatizacion.</p>
        </div>
        <div class="budgetGrid">
          {budgetLanes.map((lane) => (
            <article class="budgetCard">
              <span>{lane.name}</span>
              <strong>{lane.price}</strong>
              <p>{lane.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container glass card serviceTableWrap" data-reveal>
      <div class="sectionHead sectionHead--compact">
        <div>
          <h2 class="h2">Todos los servicios con precio desde</h2>
          <p class="muted sectionLead">Una guia rapida para comparar servicio, ideal, tiempo y alcance inicial.</p>
        </div>
        <a class="btn" href={waHome} target="_blank" rel="noreferrer">Pedir recomendacion</a>
      </div>
      <div class="tableScroll" role="region" aria-label="Tabla de servicios y precios" tabindex="0">
        <table class="serviceTable">
          <thead>
            <tr>
              <th scope="col">Servicio</th>
              <th scope="col">Ideal para</th>
              <th scope="col">Precio desde</th>
              <th scope="col">Tiempo estimado</th>
              <th scope="col">Que incluye</th>
              <th scope="col">CTA</th>
            </tr>
          </thead>
          <tbody>
            {services.map((service) => (
              <tr>
                <th scope="row">{service.title}</th>
                <td>{service.idealFor}</td>
                <td>{formatMoneyFromMXN(service.priceFromMXN, "MXN")}</td>
                <td>{service.estimatedTime}</td>
                <td>{service.bullets.slice(0, 3).join(" · ")}</td>
                <td><a href={waHome} target="_blank" rel="noreferrer">Cotizar</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="proceso">
    <div class="container">
      <div class="sectionHead" data-reveal>
        <div>
          <div class="pill">Como trabajamos</div>
          <h2 class="h2">Proceso claro, visual y sin vueltas.</h2>
        </div>
      </div>
      <div class="processGrid">
        {["Nos cuentas tu idea", "Definimos que necesitas", "Disenamos la estructura", "Desarrollamos la solucion", "Revisamos contigo", "Publicamos o entregamos"].map((step, index) => (
          <article class="processCard glass" data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step}</h3>
            <p class="muted">Cada etapa deja decisiones claras, entregables visibles y una siguiente accion concreta.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container trust glass card" data-reveal>
      <div>
        <div class="pill">Confianza</div>
        <h2 class="h2">Premium por ejecucion, no por promesas vacias.</h2>
      </div>
      <div class="trustGrid">
        {["Precios claros", "Soporte directo", "Diseno responsive", "Entrega organizada", "Codigo limpio", "Enfoque en conversion", "Soluciones personalizadas", "Comunicacion por WhatsApp/Discord"].map((item) => (
          <div class="trustItem">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="proyectos">
    <div class="container">
      <div class="sectionHead" data-reveal>
        <div>
          <div class="pill">Proyectos</div>
          <h2 class="h2">Ejemplos de soluciones que podemos construir.</h2>
        </div>
        <a class="btn" href="/portafolio/">Ver portafolio</a>
      </div>
      <div class="projectsGrid">
        {projects.map((project) => (
          <article class="projectCard glass" data-reveal>
            <div class="projectCard__type">{project.type}</div>
            <h3>{project.title}</h3>
            <p class="muted">{project.solution}</p>
            <div class="tags">
              {project.stack.slice(0, 4).map((tag) => <span>{tag}</span>)}
            </div>
            <div class="projectResult">{project.metrics[0]}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="sectionHead" data-reveal>
        <div>
          <div class="pill">FAQ</div>
          <h2 class="h2">Preguntas frecuentes antes de cotizar.</h2>
        </div>
      </div>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <section class="section">
    <div class="container finalCta glass" data-reveal>
      <div>
        <h2 class="h2">Tu proyecto puede verse premium desde el primer dia</h2>
        <p class="muted">Cuentanos tu idea y te ayudamos a convertirla en una web, bot, tienda o sistema funcional con diseno profesional y precio accesible.</p>
      </div>
      <div class="finalCta__actions">
        <a class="btn btn-primary" href={waHome} target="_blank" rel="noreferrer">Cotizar ahora</a>
        <a class="btn" href="#precios">Ver precios</a>
      </div>
    </div>
  </section>

  <style>
    .hero{ padding-top: 50px; }
    .hero__grid{
      display:grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(340px, .92fr);
      gap:22px;
      align-items:center;
    }
    .hero__title{ margin-top:18px; max-width: 12ch; }
    .hero__lead{
      max-width: 68ch;
      font-size:18px;
      line-height:1.65;
      margin:18px 0 0;
    }
    .hero__cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top:22px; }
    .badgeRow{ display:flex; gap:9px; flex-wrap:wrap; margin-top:18px; }
    .badgeRow span,
    .statusPill,
    .servicePrice,
    .priceCard__badge,
    .projectCard__type{
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.045);
      border-radius:999px;
      color:rgba(237,237,243,.84);
      font-size:13px;
      padding:8px 10px;
    }
    .heroStats{
      display:grid;
      grid-template-columns:repeat(3, minmax(0, 1fr));
      gap:10px;
      margin-top:18px;
      max-width:680px;
    }
    .heroStat{
      padding:14px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.10);
      background:linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.025));
    }
    .heroStat span,
    .heroStat small{
      display:block;
      color:var(--muted);
      font-size:12px;
      line-height:1.35;
    }
    .heroStat strong{
      display:block;
      margin:4px 0;
      font-family:var(--font-display);
      font-size:20px;
      letter-spacing:-.02em;
    }
    .pillDot{
      width:8px;
      height:8px;
      border-radius:99px;
      background:linear-gradient(180deg, #00E5FF, #8B5CF6);
      box-shadow:0 0 24px rgba(0,229,255,.34);
      display:inline-block;
    }
    .heroPanel{ padding:20px; position:relative; overflow:hidden; }
    .heroPanel::before{
      content:"";
      position:absolute;
      inset:-30% -20% auto auto;
      width:220px;
      height:220px;
      background:radial-gradient(circle, rgba(0,229,255,.20), transparent 62%);
      pointer-events:none;
    }
    .heroPanel__top{ display:flex; justify-content:space-between; gap:16px; align-items:flex-start; position:relative; }
    .heroPanel__eyebrow{ color:var(--faint); font-size:13px; }
    .heroPanel__title{ font-family:var(--font-display); font-size:24px; line-height:1.1; font-weight:700; letter-spacing:-.02em; margin-top:6px; }
    .console{
      position:relative;
      margin-top:18px;
      border-radius:22px;
      border:1px solid rgba(255,255,255,.12);
      background:
        linear-gradient(180deg, rgba(3,7,18,.76), rgba(3,7,18,.42)),
        radial-gradient(circle at 20% 10%, rgba(0,229,255,.14), transparent 32%);
      overflow:hidden;
    }
    .console__header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:14px 16px;
      border-bottom:1px solid rgba(255,255,255,.10);
      color:rgba(237,237,243,.82);
      font-size:13px;
    }
    .console__header strong{ color:#fff; font-family:var(--font-display); }
    .console__screen{ padding:12px; display:grid; gap:10px; }
    .console__row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:12px;
      border-radius:16px;
      border:1px solid rgba(255,255,255,.08);
      background:rgba(255,255,255,.035);
    }
    .console__row span{ color:var(--muted); }
    .console__row strong{ font-family:var(--font-display); font-size:14px; }
    .console__row.is-on{
      border-color:rgba(34,197,94,.22);
      background:linear-gradient(180deg, rgba(34,197,94,.10), rgba(255,255,255,.03));
    }
    .console__rail{
      display:grid;
      grid-template-columns:repeat(2, 1fr);
      gap:1px;
      border-top:1px solid rgba(255,255,255,.10);
      background:rgba(255,255,255,.08);
    }
    .console__rail a{
      padding:13px;
      background:rgba(3,7,18,.72);
      display:grid;
      gap:5px;
    }
    .console__rail span{ color:var(--muted); font-size:12px; line-height:1.25; }
    .console__rail strong{ font-family:var(--font-display); font-size:14px; }
    .heroPanel__note{ margin-top:16px; color:var(--muted); font-size:14px; line-height:1.55; position:relative; }

    .sectionHead{
      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:16px;
      margin-bottom:22px;
      flex-wrap:wrap;
    }
    .sectionHead .h2{ margin-top:14px; max-width: 760px; }

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND, TAGLINE } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
---
<BaseLayout
  page="home"
  title={`${BRAND} — ${TAGLINE}`}
  description="Agencia/lab de soluciones digitales premium: web rapida, sistemas de Discord, infraestructura Minecraft, automatizaciones y WhatsApp + IA (integraciones permitidas)."
  canonicalPath="/"
>
  <section class="section hero">
    <div class="container hero__grid">
      <div class="hero__left">
        <div class="pill" data-reveal>
          <span class="pillDot" aria-hidden="true"></span>
          <span>Diseño Apple-level · Precisión SpaceX · Entregables auditables</span>
        </div>

        <h1 class="h1 hero__title" data-reveal>
          Infraestructura digital para crecer sin friccion.
        </h1>
        <p class="hero__lead muted" data-reveal>
          Vexora Labs construye webs premium, sistemas de comunidad y automatizaciones medibles.
          Menos caos. Mas control. Mejor performance.
        </p>

        <div class="hero__cta" data-reveal>
          <a class="btn btn-primary" href={getWhatsAppLink("home")} target="_blank" rel="noreferrer">Cotizar por WhatsApp</a>
          <a class="btn" href="/servicios/">Ver servicios</a>
          <a class="btn" href="/portafolio/">Ver resultados</a>
        </div>

        <div class="hero__proof glass" data-reveal>
          <div class="kpi">
            <div class="kpi__num">+Performance</div>
            <div class="muted small">Core Web Vitals como baseline, no como extra.</div>
          </div>
          <div class="kpi">
            <div class="kpi__num">+Seguridad</div>
            <div class="muted small">Hardening basico, roles/permisos y procesos.</div>
          </div>
          <div class="kpi">
            <div class="kpi__num">+Claridad</div>
            <div class="muted small">Entregables, checklist, runbooks y handoff.</div>
          </div>
        </div>
      </div>

      <aside class="hero__right glass card" data-reveal>
        <div class="hero__panelTitle">Lo que hacemos</div>
        <div class="hero__panelGrid">
          <a class="tile" href="/web-uiux/">
            <div class="tile__title">Web / UI-UX</div>
            <div class="tile__meta muted">Landing y multipagina premium</div>
          </a>
          <a class="tile" href="/discord/">
            <div class="tile__title">Discord</div>
            <div class="tile__meta muted">Bots, automod, antiraid, tickets</div>
          </a>
          <a class="tile" href="/minecraft/">
            <div class="tile__title">Minecraft</div>
            <div class="tile__meta muted">Setup, plugins, optimizacion, seguridad</div>
          </a>
          <a class="tile" href="/whatsapp-ia/">
            <div class="tile__title">WhatsApp + IA</div>
            <div class="tile__meta muted">Integraciones oficiales y flujos</div>
          </a>
        </div>
        <div class="hero__panelNote muted">
          Nada de hacks, spam o accesos no autorizados. Construimos sistemas confiables.
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Como trabajamos</h2>
        <p class="muted" style="margin:10px 0 0;">
          Un proceso corto, medible y sin misticismo. Si no se puede operar, no se entrega.
        </p>
        <ol class="steps">
          <li>
            <span class="steps__n">1</span>
            <div>
              <div class="steps__t">Diagnostico y alcance</div>
              <div class="muted">Objetivo, restricciones, riesgos y definicion de entregables.</div>
            </div>
          </li>
          <li>
            <span class="steps__n">2</span>
            <div>
              <div class="steps__t">Diseño y arquitectura</div>
              <div class="muted">Sistema visual, flows, permisos y estructura de contenido.</div>
            </div>
          </li>
          <li>
            <span class="steps__n">3</span>
            <div>
              <div class="steps__t">Build + QA</div>
              <div class="muted">Performance, accesibilidad, seguridad basica y pruebas reales.</div>
            </div>
          </li>
          <li>
            <span class="steps__n">4</span>
            <div>
              <div class="steps__t">Entrega y soporte</div>
              <div class="muted">Checklist, documentacion, handoff y plan de mantenimiento.</div>
            </div>
          </li>
        </ol>
      </div>

      <div class="glass card" data-reveal>
        <h2 class="h2">Que entregamos</h2>
        <ul class="deliver">
          <li><strong>Artefactos operables:</strong> checklist, runbooks, configuraciones y guias.</li>
          <li><strong>UX clara:</strong> jerarquia, copy, accesibilidad y micro-interacciones.</li>
          <li><strong>Performance:</strong> carga rapida, imagenes optimizadas y codigo limpio.</li>
          <li><strong>Seguridad y etica:</strong> practicas permitidas; nada de abuso o acceso no autorizado.</li>
          <li><strong>Medicion:</strong> eventos clave y metricas para iterar sin adivinar.</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Listo para cotizar</div>
            <div class="muted small">Dinos objetivo + fecha + presupuesto aproximado.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("home")} target="_blank" rel="noreferrer">Escribir por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <div class="sectionHead">
        <div>
          <h2 class="h2">Resultados (casos reales sin marcas inventadas)</h2>
          <p class="muted" style="margin:10px 0 0;">
            Trabajamos con negocios y comunidades. Mostramos el tipo de impacto y el enfoque, no nombres.
          </p>
        </div>
        <a class="btn" href="/portafolio/">Ver portafolio completo</a>
      </div>

      <div class="cases">
        <article class="case" data-reveal>
          <div class="case__k">Cliente: eCommerce local</div>
          <div class="case__t">WhatsApp + IA + automatizaciones</div>
          <div class="case__m muted">-41% primera respuesta · +18% conversion asistida · 0 spam</div>
        </article>
        <article class="case" data-reveal>
          <div class="case__k">Cliente: servidor de comunidad</div>
          <div class="case__t">Discord antiraid + tickets + logs</div>
          <div class="case__m muted">-92% spam visible · +35% resolucion 1er contacto</div>
        </article>
        <article class="case" data-reveal>
          <div class="case__k">Cliente: servidor de Minecraft</div>
          <div class="case__t">Performance + seguridad + runbook</div>
          <div class="case__m muted">TPS mas estable · backups verificados · deploy con checklist</div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container glass card finalCta" data-reveal>
      <div>
        <h2 class="h2">Construyamos un sistema que se sienta caro.</h2>
        <p class="muted" style="margin:10px 0 0;">
          Si tu web o comunidad se siente friccionada, eso cuesta dinero. Diseñemos la solucion con precision.
        </p>
      </div>
      <div class="finalCta__actions">
        <a class="btn btn-primary" href={getWhatsAppLink("home")} target="_blank" rel="noreferrer">Cotizar por WhatsApp</a>
        <a class="btn" href="/contacto/">Enviar brief</a>
      </div>
    </div>
  </section>

  <style>
    .hero{ padding-top: 52px; }
    .hero__grid{
      display:grid;
      grid-template-columns: 1.15fr .85fr;
      gap:18px;
      align-items:start;
    }
    .hero__title{ margin-top: 16px; }
    .hero__lead{ font-size: 18px; line-height:1.6; max-width: 62ch; }
    .hero__cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 18px; }

    .hero__proof{
      margin-top: 22px;
      padding: 14px;
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:10px;
    }
    .kpi{ padding: 12px; border-radius: 16px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); }
    .kpi__num{ font-family: var(--font-display); font-weight:700; letter-spacing:-.02em; }
    .small{ font-size: 13px; }

    .hero__panelTitle{
      font-family: var(--font-display);
      font-weight:700;
      letter-spacing:-.02em;
      margin-bottom: 12px;
    }
    .hero__panelGrid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:10px;
    }
    .tile{
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 14px;
      transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }
    .tile:hover{
      transform: translateY(-2px);
      border-color: rgba(255,255,255,.18);
      background: rgba(255,255,255,.05);
    }
    .tile__title{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .tile__meta{ font-size: 13px; margin-top: 6px; }
    .hero__panelNote{ margin-top: 14px; font-size: 13px; }

    .steps{
      margin: 18px 0 0;
      padding:0;
      list-style:none;
      display:grid;
      gap:12px;
    }
    .steps li{
      display:grid;
      grid-template-columns: 34px 1fr;
      gap:12px;
      padding: 12px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
    }
    .steps__n{
      width:34px; height:34px;
      border-radius: 14px;
      display:grid; place-items:center;
      border:1px solid rgba(255,255,255,.12);
      background: linear-gradient(180deg, rgba(139,92,255,.18), rgba(255,255,255,.03));
      font-family: var(--font-display);
      font-weight:700;
    }
    .steps__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }

    .deliver{
      margin: 14px 0 0;
      padding-left: 18px;
      color: rgba(237,237,243,.84);
    }
    .deliver li{ margin: 10px 0; }

    .ctaBox{
      margin-top: 18px;
      padding: 14px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }

    .sectionHead{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      margin-bottom: 14px;
      flex-wrap:wrap;
    }
    .cases{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:12px;
    }
    .case{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 16px;
    }
    .case__k{ font-size: 12px; color: rgba(237,237,243,.72); }
    .case__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; margin-top: 6px; }
    .case__m{ margin-top: 10px; font-size: 13px; }

    .finalCta{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }
    .finalCta__actions{ display:flex; gap:10px; flex-wrap:wrap; }

    @media (max-width: 1060px){
      .hero__grid{ grid-template-columns: 1fr; }
      .hero__proof{ grid-template-columns: 1fr; }
      .cases{ grid-template-columns: 1fr; }
    }

    .pillDot{
      width:8px; height:8px; border-radius:99px;
      background: linear-gradient(180deg, rgba(106,228,255,.85), rgba(139,92,255,.65));
      box-shadow: 0 0 22px rgba(139,92,255,.22);
      display:inline-block;
    }
  </style>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
---
<BaseLayout
  page="discord"
  title={`Discord systems — ${BRAND}`}
  description="Bots, automod, antiraid, tickets, setups, logs y onboarding. Discord ordenado, escalable y auditable (sin hacks)."
  canonicalPath="/discord/"
>
  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <div class="pill">Discord</div>
        <h1 class="h1" style="margin-top:14px;">Menos ruido. Mas control.</h1>
        <p class="muted" style="margin:12px 0 0; max-width:70ch;">
          Diseñamos servidores y bots con mentalidad de sistema: roles claros, moderacion consistente, auditoria y experiencia
          de usuario desde el primer mensaje.
        </p>
        <div class="cta" data-reveal>
          <a class="btn btn-primary" href={getWhatsAppLink("discord")} target="_blank" rel="noreferrer">Cotizar por WhatsApp</a>
          <a class="btn" href="/precios/">Ver paquetes</a>
          <a class="btn" href="/seguridad-etica/">Seguridad y etica</a>
        </div>
        <div class="disclaimer muted small" data-reveal>
          Nota: No hacemos hacks, doxxing, raids, spam ni accesos no autorizados. Solo sistemas de moderacion y operacion legitimos.
        </div>
      </div>

      <aside class="glass card" data-reveal>
        <div class="h3">Entregables tipicos</div>
        <ul class="list">
          <li>Arquitectura de canales (estructura que escala).</li>
          <li>Roles y permisos con principio de minimo privilegio.</li>
          <li>Automod: filtros, rate-limits, quarantine y apelaciones.</li>
          <li>Anti-raid por capas (sin romper UX legitima).</li>
          <li>Tickets: soporte, reportes, solicitudes, plantillas.</li>
          <li>Logs: moderacion y auditoria (quien hizo que, cuando y por que).</li>
          <li>Playbook para tu staff (como operar y responder).</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <div class="sectionHead">
        <h2 class="h2">Modulos (elige por necesidad)</h2>
        <a class="btn btn-primary" href={getWhatsAppLink("discord")} target="_blank" rel="noreferrer">Cotizar por WhatsApp</a>
      </div>
      <div class="grid3">
        <article class="mod" data-reveal>
          <div class="mod__t">Onboarding premium</div>
          <p class="muted">Verificacion, roles automaticos, reglas claras y rutas por intereses.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Tickets + flujos</div>
          <p class="muted">Categorias, formularios, SLA, handoff y cierre con resumen.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Antiraid por capas</div>
          <p class="muted">Proteccion sin friccion: rate limits, quarantine, alertas y rollback.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Moderacion consistente</div>
          <p class="muted">Reglas aplicables, plantillas, escalamiento y appeals.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Logs auditables</div>
          <p class="muted">Visibilidad para evitar abuso y mantener confianza.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Integraciones</div>
          <p class="muted">Webhooks, alerts, paneles, forms y automatizaciones permitidas.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Soporte y garantia (realista)</h2>
        <ul class="list">
          <li>Ventana de ajustes post-entrega (7 dias habiles) para pulir UX y permisos.</li>
          <li>Documentacion y checklist de operacion para tu staff.</li>
          <li>Si algo se rompe por cambios de Discord o bots externos, te proponemos fix y plan.</li>
        </ul>
      </div>
      <div class="glass card" data-reveal>
        <h2 class="h2">Por que Vexora</h2>
        <ul class="list">
          <li>Diseño limpio: el staff encuentra todo en segundos.</li>
          <li>Ingenieria: reglas por capas, no parches improvisados.</li>
          <li>Seguridad: menos permisos, mas trazabilidad.</li>
          <li>Entrega: no solo configuracion; tambien proceso y runbook.</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Brief rapido</div>
            <div class="muted small">Tamaño de comunidad, riesgos, modulos y fecha.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("discord")} target="_blank" rel="noreferrer">Escribir</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 16px; }
    .small{ font-size: 13px; }
    .disclaimer{ margin-top: 14px; }
    .list{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .list li{ margin: 9px 0; }
    .sectionHead{
      display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap;
      margin-bottom: 12px;
    }
    .grid3{ display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; }
    .mod{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 16px;
    }
    .mod__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .ctaBox{
      margin-top: 16px;
      padding: 14px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    @media (max-width: 980px){
      .grid3{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>


---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServicesExplorer from "@/components/ServicesExplorer.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
---
<BaseLayout
  page="servicios"
  title={`Servicios — ${BRAND}`}
  description="Servicios digitales premium accesibles: landing pages, webs, tiendas online, bots de Discord, servidores Minecraft, automatizaciones, UI/UX y branding."
  canonicalPath="/servicios/"
>
  <section class="section">
    <div class="container">
      <div class="head glass card" data-reveal>
        <div>
        <div class="pill">Servicios</div>
          <h1 class="h1" style="margin-top:14px;">Soluciones digitales claras, rapidas y funcionales.</h1>
          <p class="muted" style="margin:12px 0 0; max-width:70ch;">
            Creamos webs, bots, tiendas, servidores y automatizaciones para que tu marca se vea profesional,
            venda mejor y opere con menos friccion. Definimos alcance, entregables y tiempos antes de empezar.
          </p>
        </div>
        <div class="head__cta">
          <a class="btn btn-primary" href={getWhatsAppLink("servicios")} target="_blank" rel="noreferrer">Cotizar por WhatsApp</a>
          <a class="btn" href="/precios/">Ver paquetes</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <ServicesExplorer page="servicios" />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Diferenciadores</h2>
        <ul class="list">
          <li><strong>Diseno premium accesible:</strong> una presencia profesional sin presupuestos enormes.</li>
          <li><strong>UX sin ruido:</strong> jerarquia, mobile-first, micro-interacciones y CTAs claros.</li>
          <li><strong>Implementacion limpia:</strong> performance, SEO basico, componentes reutilizables y QA.</li>
          <li><strong>Entrega organizada:</strong> checklist, documentacion y soporte opcional.</li>
        </ul>
      </div>
      <div class="glass card" data-reveal>
        <h2 class="h2">Tiempos tipicos</h2>
        <div class="timeline">
          <div class="tItem">
            <div class="tItem__k">Web premium</div>
            <div class="muted">Desde 5 dias en landing starter; 12-18 dias en web multipagina.</div>
          </div>
          <div class="tItem">
            <div class="tItem__k">Discord / Minecraft</div>
            <div class="muted">Desde 3-7 dias en base; hasta 12-14 dias en configuraciones pro.</div>
          </div>
          <div class="tItem">
            <div class="tItem__k">Tiendas / automatizaciones</div>
            <div class="muted">Tiendas desde 14 dias. Automatizaciones pro suelen ir de 2 a 4 semanas.</div>
          </div>
          <div class="tItem">
            <div class="tItem__k">Automatizaciones</div>
            <div class="muted">Desde 1 semana para un flujo, hasta 4+ para operaciones multi-canal.</div>
          </div>
        </div>
        <div class="note muted small">
          En proyectos con riesgo (migraciones, comunidades grandes) proponemos etapas para evitar downtime.
        </div>
      </div>
    </div>
  </section>

  <style>
    .head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }
    .head__cta{ display:flex; gap:10px; flex-wrap:wrap; }
    .list{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .list li{ margin: 10px 0; }
    .timeline{
      margin-top: 12px;
      display:grid;
      gap:10px;
    }
    .tItem{
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 14px;
    }
    .tItem__k{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .small{ font-size: 13px; }
    .note{ margin-top: 12px; }
  </style>
</BaseLayout>

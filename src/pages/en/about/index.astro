---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND, getTagline } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { routeFor } from "@/lib/routes";

const TAGLINE = getTagline("en");
---
<BaseLayout
  page="sobre"
  title={`About — ${BRAND}`}
  description="Vexora Labs process and values: precision, performance, security, and premium UX. Digital infrastructure to grow without friction."
  canonicalPath="/en/about/"
>
  <section class="section">
    <div class="container head glass card" data-reveal>
      <div>
        <div class="pill">About Vexora</div>
        <h1 class="h1" style="margin-top:14px;">{TAGLINE}</h1>
        <p class="muted" style="margin:12px 0 0; max-width:80ch;">
          Vexora Labs is a studio/lab focused on building premium digital systems: clean UI, real performance, and operable delivery.
          Our obsession: making your product or community feel stable, clear, and trustworthy.
        </p>
      </div>
      <div class="head__cta">
        <a class="btn btn-primary" href={getWhatsAppLink("sobre", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
        <a class="btn" href={routeFor("servicios", "en")}>View services</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Values</h2>
        <div class="values">
          <div class="val" data-reveal>
            <div class="val__t">Precision</div>
            <div class="muted">Less opinions, more decisions with clear tradeoffs.</div>
          </div>
          <div class="val" data-reveal>
            <div class="val__t">Performance</div>
            <div class="muted">Speed and simplicity are part of the design, not late optimization.</div>
          </div>
          <div class="val" data-reveal>
            <div class="val__t">Security</div>
            <div class="muted">Least privilege, auditability, and processes that prevent incidents.</div>
          </div>
          <div class="val" data-reveal>
            <div class="val__t">Operable delivery</div>
            <div class="muted">Checklists, runbooks, and handoff so you don’t depend on us.</div>
          </div>
        </div>
      </div>

      <div class="glass card" data-reveal>
        <h2 class="h2">Process (step by step)</h2>
        <ol class="steps">
          <li><span class="n">1</span><div><div class="t">Short discovery</div><div class="muted">Goal, constraints, risks, and success definition.</div></div></li>
          <li><span class="n">2</span><div><div class="t">System design</div><div class="muted">UI, flows, permissions, architecture, and documented decisions.</div></div></li>
          <li><span class="n">3</span><div><div class="t">Build</div><div class="muted">Components, integrations, and incremental QA.</div></div></li>
          <li><span class="n">4</span><div><div class="t">QA + delivery</div><div class="muted">Performance, accessibility, and final checklist with handoff.</div></div></li>
        </ol>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Want to see what it looks like for your case?</div>
            <div class="muted small">In 10 minutes on WhatsApp we can land the scope.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("sobre", "en")} target="_blank" rel="noreferrer">Message</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <h2 class="h2">Why it matters</h2>
      <div class="why">
        <div class="why__item" data-reveal>
          <div class="why__t">A slow website loses money.</div>
          <div class="muted">It’s not aesthetics: it’s conversion, SEO, and trust.</div>
        </div>
        <div class="why__item" data-reveal>
          <div class="why__t">A community without processes becomes risk.</div>
          <div class="muted">Roles/permissions and logs prevent abuse and chaos.</div>
        </div>
        <div class="why__item" data-reveal>
          <div class="why__t">Automation without ethics destroys reputation.</div>
          <div class="muted">We prefer official integrations and consent.</div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }
    .head__cta{ display:flex; gap:10px; flex-wrap:wrap; }
    .values{ display:grid; gap:10px; margin-top: 14px; }
    .val{
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 14px;
    }
    .val__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }

    .steps{ margin: 14px 0 0; padding:0; list-style:none; display:grid; gap:10px; }
    .steps li{ display:grid; grid-template-columns: 34px 1fr; gap:12px; padding: 12px; border-radius: 18px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); }
    .n{ width:34px; height:34px; border-radius: 14px; display:grid; place-items:center; border:1px solid rgba(255,255,255,.12); background: linear-gradient(180deg, rgba(139,92,255,.18), rgba(255,255,255,.03)); font-family: var(--font-display); font-weight:700; }
    .t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .small{ font-size: 13px; }
    .ctaBox{ margin-top: 16px; padding: 14px; border-radius: 18px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }

    .why{
      margin-top: 14px;
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:12px;
    }
    .why__item{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 16px;
    }
    .why__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    @media (max-width: 980px){
      .why{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>


---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExpressQuote from "@/components/ExpressQuote.astro";
import PricingComparator from "@/components/PricingComparator.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { routeFor } from "@/lib/routes";
---
<BaseLayout
  page="precios"
  title={`Pricing — ${BRAND}`}
  description="Clear packages (one-time) + optional monthly support. Premium comparison, deliverables, and security disclaimers."
  canonicalPath="/en/pricing/"
>
  <section class="section">
    <div class="container head glass card" data-reveal>
      <div>
        <div class="pill">Pricing</div>
        <h1 class="h1" style="margin-top:14px;">Packages designed to operate.</h1>
        <p class="muted" style="margin:12px 0 0; max-width:78ch;">
          We prefer clarity over “cheap”. We price by impact and complexity. If you need something special, we’ll propose a custom plan.
        </p>
      </div>
      <div class="head__cta">
        <a class="btn btn-primary" href={getWhatsAppLink("precios", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
        <button class="btn" type="button" data-open-cotizador>Express quote</button>
        <a class="btn" href={routeFor("contacto", "en")}>Send a brief</a>
        <a class="btn" href={routeFor("agenda", "en")} data-track="open_agenda">Schedule a call</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <ExpressQuote />
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <PricingComparator page="precios" />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Custom / Enterprise</h2>
        <p class="muted" style="margin:12px 0 0;">
          If your project mixes web + Discord + automations + WhatsApp Business API, we propose stages:
          discovery, build, and operations. That reduces risk and avoids rework.
        </p>
        <ul class="list">
          <li>Architecture and milestone roadmap.</li>
          <li>Security and permissions (least privilege).</li>
          <li>Playbooks + handoff to your team.</li>
          <li>Monitoring and continuous QA (optional).</li>
        </ul>
      </div>
      <div class="glass card" data-reveal>
        <h2 class="h2">Important notes</h2>
        <ul class="list">
          <li>We don’t promise impossible outcomes (guaranteed sales, “no failures”, etc.).</li>
          <li>We don’t do hacks, spam, scraping, or unauthorized access.</li>
          <li>WhatsApp + AI requires official routes (WABA) and often includes provider/license costs.</li>
          <li>Hosting, domains, and licenses are not included unless agreed.</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">I want a custom plan</div>
            <div class="muted small">Share goal, stack, timelines, and constraints.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("precios", "en")} target="_blank" rel="noreferrer">Message</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }
    .head__cta{ display:flex; gap:10px; flex-wrap:wrap; }
    .list{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .list li{ margin: 10px 0; }
    .small{ font-size: 13px; }
    .ctaBox{
      margin-top: 16px;
      padding: 14px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
  </style>
</BaseLayout>

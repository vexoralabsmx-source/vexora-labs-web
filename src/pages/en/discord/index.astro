---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { routeFor } from "@/lib/routes";
---
<BaseLayout
  page="discord"
  title={`Discord systems — ${BRAND}`}
  description="Bots, automod, anti-raid, tickets, setups, logs, and onboarding. Discord that is organized, scalable, and auditable (no hacks)."
  canonicalPath="/en/discord/"
>
  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <div class="pill">Discord</div>
        <h1 class="h1" style="margin-top:14px;">Less noise. More control.</h1>
        <p class="muted" style="margin:12px 0 0; max-width:70ch;">
          We design servers and bots with a systems mindset: clear roles, consistent moderation, auditability, and a great UX from the first message.
        </p>
        <div class="cta" data-reveal>
          <a class="btn btn-primary" href={getWhatsAppLink("discord", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
          <a class="btn" href={routeFor("precios", "en")}>View packages</a>
          <a class="btn" href={routeFor("seguridad", "en")}>Security & ethics</a>
        </div>
        <div class="disclaimer muted small" data-reveal>
          Note: We don’t do hacks, doxxing, raids, spam, or unauthorized access. Only legitimate moderation and ops systems.
        </div>
      </div>

      <aside class="glass card" data-reveal>
        <div class="h3">Typical deliverables</div>
        <ul class="list">
          <li>Channel architecture (structure that scales).</li>
          <li>Roles and permissions with least privilege.</li>
          <li>Automod: filters, rate limits, quarantine, appeals.</li>
          <li>Layered anti-raid (without breaking legitimate UX).</li>
          <li>Tickets: support, reports, requests, templates.</li>
          <li>Logs: moderation and audit (who did what, when, and why).</li>
          <li>Playbook for your staff (how to operate and respond).</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <div class="sectionHead">
        <h2 class="h2">Modules (pick what you need)</h2>
        <a class="btn btn-primary" href={getWhatsAppLink("discord", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
      </div>
      <div class="grid3">
        <article class="mod" data-reveal>
          <div class="mod__t">Premium onboarding</div>
          <p class="muted">Verification, auto-roles, clear rules, and intent-based paths.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Tickets + flows</div>
          <p class="muted">Categories, forms, SLAs, handoffs, and closure summaries.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Layered anti-raid</div>
          <p class="muted">Protection without friction: rate limits, quarantine, alerts, rollback.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Consistent moderation</div>
          <p class="muted">Actionable rules, templates, escalation, and appeals.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Auditable logs</div>
          <p class="muted">Visibility to prevent abuse and maintain trust.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Integrations</div>
          <p class="muted">Webhooks, alerts, panels, forms, and compliant automations.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Support & warranty (realistic)</h2>
        <ul class="list">
          <li>Post-delivery adjustment window (7 business days) to fine-tune UX and permissions.</li>
          <li>Documentation and ops checklist for your staff.</li>
          <li>If Discord or external bots change, we propose a fix and plan.</li>
        </ul>
      </div>
      <div class="glass card" data-reveal>
        <h2 class="h2">Why Vexora</h2>
        <ul class="list">
          <li>Clean design: staff finds everything in seconds.</li>
          <li>Engineering: layered rules, not improvised patches.</li>
          <li>Security: fewer permissions, more traceability.</li>
          <li>Delivery: not just configuration; also process and runbook.</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Quick brief</div>
            <div class="muted small">Community size, risks, modules, and date.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("discord", "en")} target="_blank" rel="noreferrer">Message</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 16px; }
    .small{ font-size: 13px; }
    .disclaimer{ margin-top: 14px; }
    .list{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .list li{ margin: 9px 0; }
    .sectionHead{
      display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap;
      margin-bottom: 12px;
    }
    .grid3{ display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; }
    .mod{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 16px;
    }
    .mod__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .ctaBox{
      margin-top: 16px;
      padding: 14px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    @media (max-width: 980px){
      .grid3{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>


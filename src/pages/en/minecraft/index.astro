---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { routeFor } from "@/lib/routes";
---
<BaseLayout
  page="minecraft"
  title={`Minecraft infra — ${BRAND}`}
  description="Minecraft server setup: plugins, optimization, security, backups, and runbooks. Stability first, features second."
  canonicalPath="/en/minecraft/"
>
  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <div class="pill">Minecraft</div>
        <h1 class="h1" style="margin-top:14px;">Stability before features.</h1>
        <p class="muted" style="margin:12px 0 0; max-width:72ch;">
          A server that crashes or lags constantly leaks trust. We build operable infrastructure:
          performance, basic security, backups, and an update process with rollback.
        </p>
        <div class="cta" data-reveal>
          <a class="btn btn-primary" href={getWhatsAppLink("minecraft", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
          <a class="btn" href={routeFor("precios", "en")}>View packages</a>
          <a class="btn" href={routeFor("seguridad", "en")}>Security & ethics</a>
        </div>
        <div class="disclaimer muted small" data-reveal>
          Note: We don’t do dupe glitches, cheats, exploits, or unauthorized access. Only configuration, basic hardening, and legitimate ops.
        </div>
      </div>

      <aside class="glass card" data-reveal>
        <div class="h3">What we deliver</div>
        <ul class="list">
          <li>Server setup and clean folder structure.</li>
          <li>Plugin configuration (based on goal).</li>
          <li>Optimization (tuning) for peaks and stability.</li>
          <li>Basic security: permissions, whitelist/banlists, limits, alerts.</li>
          <li>Automated backups + test restores.</li>
          <li>Runbook: how to update, monitor, and respond to incidents.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <div class="sectionHead">
        <h2 class="h2">Architecture (engineering vibes)</h2>
        <a class="btn btn-primary" href={getWhatsAppLink("minecraft", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
      </div>
      <div class="grid3">
        <article class="mod" data-reveal>
          <div class="mod__t">Performance</div>
          <p class="muted">Tick tuning, view distance, entities, and scenario-based settings.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Basic security</div>
          <p class="muted">Permissions, access controls, anti-griefing (if needed), best practices.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Backups + rollback</div>
          <p class="muted">Scheduled backups, retention, verification, test restores.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Operations</div>
          <p class="muted">Update checklists, windows, monitoring, incident response.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Plugins and UX</div>
          <p class="muted">Lobby, permissions, economy (if applicable), coherent experience.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Documentation</div>
          <p class="muted">What’s not documented becomes debt. We deliver clear guides.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Recommended process</h2>
        <ol class="steps">
          <li><span class="n">1</span><div><div class="t">Goal and rules</div><div class="muted">Survival, Skyblock, roleplay, minigames, etc. Everything changes with the goal.</div></div></li>
          <li><span class="n">2</span><div><div class="t">Baseline and hardening</div><div class="muted">Permissions, access, limits, backups, minimal monitoring.</div></div></li>
          <li><span class="n">3</span><div><div class="t">Plugins + tuning</div><div class="muted">Only what’s needed, measured, with a rollback plan.</div></div></li>
          <li><span class="n">4</span><div><div class="t">Peak QA</div><div class="muted">Controlled tests: performance, permissions, common scenarios.</div></div></li>
        </ol>
      </div>
      <div class="glass card" data-reveal>
        <h2 class="h2">Support & warranty</h2>
        <ul class="list">
          <li>Post-delivery adjustments (7 business days) for tuning and permissions.</li>
          <li>If you add new plugins, we recommend staging tests before production.</li>
          <li>Realistic guarantees: stability improves with operations, not magic promises.</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Quick brief</div>
            <div class="muted small">Version, hosting, peak players, mode, desired plugins.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("minecraft", "en")} target="_blank" rel="noreferrer">Message</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 16px; }
    .small{ font-size: 13px; }
    .disclaimer{ margin-top: 14px; }
    .list{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .list li{ margin: 9px 0; }
    .sectionHead{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom: 12px; }
    .grid3{ display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; }
    .mod{ border-radius: 20px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); padding: 16px; }
    .mod__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .steps{ margin: 14px 0 0; padding:0; list-style:none; display:grid; gap:10px; }
    .steps li{ display:grid; grid-template-columns: 34px 1fr; gap:12px; padding: 12px; border-radius: 18px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); }
    .n{ width:34px; height:34px; border-radius: 14px; display:grid; place-items:center; border:1px solid rgba(255,255,255,.12); background: linear-gradient(180deg, rgba(139,92,255,.18), rgba(255,255,255,.03)); font-family: var(--font-display); font-weight:700; }
    .t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .ctaBox{ margin-top: 16px; padding: 14px; border-radius: 18px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    @media (max-width: 980px){
      .grid3{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>


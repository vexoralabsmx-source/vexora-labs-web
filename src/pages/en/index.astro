---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND, getTagline } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { routeFor } from "@/lib/routes";

const TAGLINE = getTagline("en");
---
<BaseLayout
  page="home"
  title={`${BRAND} — ${TAGLINE}`}
  description="Premium digital systems: fast websites, Discord systems, Minecraft infrastructure, compliant automations, and WhatsApp + AI."
  canonicalPath="/en/"
>
  <section class="section hero">
    <div class="container hero__grid">
      <div class="hero__left">
        <div class="pill" data-reveal>
          <span class="pillDot" aria-hidden="true"></span>
          <span>Apple-level design · SpaceX-level precision · Auditable deliverables</span>
        </div>

        <h1 class="h1 hero__title" data-reveal>{TAGLINE}</h1>
        <p class="hero__lead muted" data-reveal>
          Vexora Labs builds premium websites, community systems, and measurable automations.
          Less chaos. More control. Better performance.
        </p>

        <div class="hero__cta" data-reveal>
          <a class="btn btn-primary" href={getWhatsAppLink("home", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
          <a class="btn" href={routeFor("servicios", "en")}>View services</a>
          <a class="btn" href={routeFor("portafolio", "en")}>See results</a>
        </div>

        <div class="hero__proof glass" data-reveal>
          <div class="kpi">
            <div class="kpi__num">+Performance</div>
            <div class="muted small">Core Web Vitals as the baseline, not an add-on.</div>
          </div>
          <div class="kpi">
            <div class="kpi__num">+Security</div>
            <div class="muted small">Basic hardening, roles/permissions, and processes.</div>
          </div>
          <div class="kpi">
            <div class="kpi__num">+Clarity</div>
            <div class="muted small">Deliverables, checklists, runbooks, and clean handoffs.</div>
          </div>
        </div>
      </div>

      <aside class="hero__right glass card" data-reveal>
        <div class="hero__panelTitle">What we do</div>
        <div class="hero__panelGrid">
          <a class="tile" href={routeFor("web", "en")}>
            <div class="tile__title">Web / UI-UX</div>
            <div class="tile__meta muted">Premium landing pages and multi-page sites</div>
          </a>
          <a class="tile" href={routeFor("discord", "en")}>
            <div class="tile__title">Discord</div>
            <div class="tile__meta muted">Bots, automod, anti-raid, tickets</div>
          </a>
          <a class="tile" href={routeFor("minecraft", "en")}>
            <div class="tile__title">Minecraft</div>
            <div class="tile__meta muted">Setup, plugins, optimization, security</div>
          </a>
          <a class="tile" href={routeFor("whatsapp", "en")}>
            <div class="tile__title">WhatsApp + AI</div>
            <div class="tile__meta muted">Compliant integrations and flows</div>
          </a>
        </div>
        <div class="hero__panelNote muted">
          No hacks, spam, or unauthorized access. We build reliable systems.
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">How we work</h2>
        <p class="muted" style="margin:10px 0 0;">
          A short, measurable process with no mysticism. If it can’t be operated, it doesn’t ship.
        </p>
        <ol class="steps">
          <li>
            <span class="steps__n">1</span>
            <div>
              <div class="steps__t">Diagnosis & scope</div>
              <div class="muted">Goals, constraints, risks, and clear deliverables.</div>
            </div>
          </li>
          <li>
            <span class="steps__n">2</span>
            <div>
              <div class="steps__t">Design & architecture</div>
              <div class="muted">Visual system, flows, permissions, and content structure.</div>
            </div>
          </li>
          <li>
            <span class="steps__n">3</span>
            <div>
              <div class="steps__t">Build + QA</div>
              <div class="muted">Performance, accessibility, basic security, and real testing.</div>
            </div>
          </li>
          <li>
            <span class="steps__n">4</span>
            <div>
              <div class="steps__t">Delivery & support</div>
              <div class="muted">Checklist, documentation, handoff, and maintenance plan.</div>
            </div>
          </li>
        </ol>
      </div>

      <div class="glass card" data-reveal>
        <h2 class="h2">What you get</h2>
        <ul class="deliver">
          <li><strong>Operational artifacts:</strong> checklists, runbooks, configurations, guides.</li>
          <li><strong>Clear UX:</strong> hierarchy, copy, accessibility, micro-interactions.</li>
          <li><strong>Performance:</strong> fast loads, optimized assets, clean code.</li>
          <li><strong>Security & ethics:</strong> compliant practices; no abuse or unauthorized access.</li>
          <li><strong>Measurement:</strong> key events and metrics to iterate without guessing.</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Ready for a quote</div>
            <div class="muted small">Share goal + timeline + rough budget.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("home", "en")} target="_blank" rel="noreferrer">Message on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <div class="sectionHead">
        <div>
          <h2 class="h2">Results (real cases, no fake brands)</h2>
          <p class="muted" style="margin:10px 0 0;">
            We work with businesses and communities. We show the impact and approach — not names.
          </p>
        </div>
        <a class="btn" href={routeFor("portafolio", "en")}>See full portfolio</a>
      </div>

      <div class="cases">
        <article class="case" data-reveal>
          <div class="case__k">Client: local eCommerce</div>
          <div class="case__t">WhatsApp + AI + automations</div>
          <div class="case__m muted">-41% first response · +18% assisted conversion · 0 spam</div>
        </article>
        <article class="case" data-reveal>
          <div class="case__k">Client: community server</div>
          <div class="case__t">Discord anti-raid + tickets + logs</div>
          <div class="case__m muted">-92% visible spam · +35% 1st-contact resolution</div>
        </article>
        <article class="case" data-reveal>
          <div class="case__k">Client: Minecraft server</div>
          <div class="case__t">Performance + security + runbook</div>
          <div class="case__m muted">More stable TPS · verified backups · checklist deploy</div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container glass card finalCta" data-reveal>
      <div>
        <h2 class="h2">Let’s build a system that feels expensive.</h2>
        <p class="muted" style="margin:10px 0 0;">
          Friction costs money. Let’s design a solution with precision.
        </p>
      </div>
      <div class="finalCta__actions">
        <a class="btn btn-primary" href={getWhatsAppLink("home", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
        <a class="btn" href={routeFor("contacto", "en")}>Send a brief</a>
      </div>
    </div>
  </section>

  <style>
    .hero{ padding-top: 52px; }
    .hero__grid{
      display:grid;
      grid-template-columns: 1.15fr .85fr;
      gap:18px;
      align-items:start;
    }
    .hero__title{ margin-top: 16px; }
    .hero__lead{ font-size: 18px; line-height:1.6; max-width: 62ch; }
    .hero__cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 18px; }

    .hero__proof{
      margin-top: 22px;
      padding: 14px;
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:10px;
    }
    .kpi{ padding: 12px; border-radius: 16px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); }
    .kpi__num{ font-family: var(--font-display); font-weight:700; letter-spacing:-.02em; }
    .small{ font-size: 13px; }

    .hero__panelTitle{
      font-family: var(--font-display);
      font-weight:700;
      letter-spacing:-.02em;
      margin-bottom: 12px;
    }
    .hero__panelGrid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:10px;
    }
    .tile{
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 14px;
      transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }
    .tile:hover{
      transform: translateY(-2px);
      border-color: rgba(255,255,255,.18);
      background: rgba(255,255,255,.05);
    }
    .tile__title{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .tile__meta{ font-size: 13px; margin-top: 6px; }
    .hero__panelNote{ margin-top: 14px; font-size: 13px; }

    .steps{
      margin: 18px 0 0;
      padding:0;
      list-style:none;
      display:grid;
      gap:12px;
    }
    .steps li{
      display:grid;
      grid-template-columns: 38px 1fr;
      gap:12px;
      padding: 12px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
    }
    .steps__n{
      width:38px; height:38px;
      display:grid;
      place-items:center;
      border-radius: 16px;
      border:1px solid rgba(255,255,255,.12);
      background: linear-gradient(180deg, rgba(139,92,255,.18), rgba(255,255,255,.03));
      font-family: var(--font-display);
      font-weight:700;
    }
    .steps__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .deliver{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .deliver li{ margin: 10px 0; }
    .ctaBox{
      margin-top: 16px;
      padding: 14px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      flex-wrap:wrap;
    }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }

    .sectionHead{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
      margin-bottom: 12px;
    }
    .cases{ display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; margin-top: 14px; }
    .case{
      border-radius: 20px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding: 16px;
    }
    .case__k{ font-size: 13px; color: rgba(237,237,243,.74); }
    .case__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; margin-top: 8px; }
    .case__m{ font-size: 13px; margin-top: 8px; }

    .finalCta{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }
    .finalCta__actions{ display:flex; gap:10px; flex-wrap:wrap; }

    @media (max-width: 980px){
      .hero__grid{ grid-template-columns:1fr; }
      .hero__proof{ grid-template-columns:1fr; }
      .hero__panelGrid{ grid-template-columns: 1fr; }
      .cases{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>


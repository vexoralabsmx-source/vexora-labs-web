---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { routeFor } from "@/lib/routes";
---
<BaseLayout
  page="whatsapp"
  title={`WhatsApp + AI — ${BRAND}`}
  description="Compliant automations for sales/support: WhatsApp Business API, flows, integrations, and QA. No spam, no unauthorized access."
  canonicalPath="/en/whatsapp-ai/"
>
  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <div class="pill">WhatsApp + AI</div>
        <h1 class="h1" style="margin-top:14px;">Automate without breaking trust.</h1>
        <p class="muted" style="margin:12px 0 0; max-width:74ch;">
          We design support and sales flows with official integrations and compliant practices:
          WhatsApp Business API (via an authorized provider), human handoff, and tone QA.
        </p>
        <div class="cta" data-reveal>
          <a class="btn btn-primary" href={getWhatsAppLink("whatsapp", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
          <a class="btn" href={routeFor("precios", "en")}>View packages</a>
          <a class="btn" href={routeFor("seguridad", "en")}>Security & ethics</a>
        </div>
        <div class="disclaimer glass" data-reveal>
          <div class="disclaimer__t">Important</div>
          <p class="muted small" style="margin:8px 0 0;">
            We don’t do spam, scraping, unsolicited bulk messaging, policy bypass, or unauthorized access.
            If you need WhatsApp, we propose official routes (WABA) and consent-based flows.
          </p>
        </div>
      </div>

      <aside class="glass card" data-reveal>
        <div class="h3">Use cases</div>
        <ul class="list">
          <li>Lead qualification (sales) with human handoff.</li>
          <li>Support: returns, shipping, warranties, appointments.</li>
          <li>Intent routing (sales/support/post-sale).</li>
          <li>Tags and CRM sync.</li>
          <li>AI-assisted replies (with approval/guardrails).</li>
          <li>Metrics: response times, frequent topics, quality.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <div class="sectionHead">
        <h2 class="h2">Recommended flow (operable)</h2>
        <a class="btn btn-primary" href={getWhatsAppLink("whatsapp", "en")} target="_blank" rel="noreferrer">Get a quote on WhatsApp</a>
      </div>
      <div class="grid3">
        <article class="mod" data-reveal>
          <div class="mod__t">1) Intake</div>
          <p class="muted">First message, consent, intent detection, context.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">2) Routing</div>
          <p class="muted">Sales, support, or human. No infinite loops.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">3) Resolution</div>
          <p class="muted">Guided answers, knowledge base, clear policies.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">4) Handoff</div>
          <p class="muted">Transfer to an agent with summary: context, tags, next step.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">5) QA & tone</div>
          <p class="muted">Guardrails: what to say/what not to say, conversation reviews.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">6) Measurement</div>
          <p class="muted">Actionable metrics: response, resolution, drop-off, topics.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">What we need to start</h2>
        <ul class="list">
          <li>Goal: sales, support, or both.</li>
          <li>Tone guide (how your brand speaks).</li>
          <li>Policies: shipping, returns, pricing, appointments.</li>
          <li>Current tools (CRM, sheets, email, website).</li>
          <li>Approximate conversation volume.</li>
        </ul>
      </div>
      <div class="glass card" data-reveal>
        <h2 class="h2">Risks we avoid</h2>
        <ul class="list">
          <li>Wrong replies due to missing context (guardrails + handoff).</li>
          <li>Automating without consent (basic compliance).</li>
          <li>Flows with no exit (real conversational UX).</li>
          <li>Dependence on a “magic prompt” (docs and QA).</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Quick brief</div>
            <div class="muted small">Industry, volume, CRM, goal, date.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("whatsapp", "en")} target="_blank" rel="noreferrer">Message</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 16px; }
    .small{ font-size: 13px; }
    .list{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .list li{ margin: 9px 0; }
    .disclaimer{ margin-top: 16px; padding: 14px; border-radius: 18px; }
    .disclaimer__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .sectionHead{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom: 12px; }
    .grid3{ display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; }
    .mod{ border-radius: 20px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); padding: 16px; }
    .mod__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .ctaBox{ margin-top: 16px; padding: 14px; border-radius: 18px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    @media (max-width: 980px){
      .grid3{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>


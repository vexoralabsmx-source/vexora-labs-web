---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
import { routeFor } from "@/lib/routes";

const SUPABASE_URL = (import.meta.env.PUBLIC_SUPABASE_URL ?? "").trim();
const SUPABASE_ANON_KEY = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "").trim();
---
<BaseLayout
  page="cuenta"
  title={`Account — ${BRAND}`}
  description="Create an account or sign in to save your info and send a complete summary to WhatsApp."
  canonicalPath="/en/account/"
>
  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <div class="pill">Account</div>
        <h1 class="h1" style="margin-top:14px;">Sign up / Sign in</h1>
        <p class="muted" style="margin:12px 0 0; max-width:78ch;">
          This is v1 (marketing/ops). Don’t use it for sensitive information. The goal is to save your brief and send a complete
          summary via WhatsApp.
        </p>
        <div class="cta" style="margin-top:16px;">
          <a class="btn btn-primary" href={getWhatsAppLink("cuenta", "en")} target="_blank" rel="noreferrer">Go to WhatsApp</a>
          <a class="btn" href={`${routeFor("contacto", "en")}#brief-builder`}>Guided brief</a>
        </div>
      </div>

      <div class="glass card" data-reveal>
        <div class="h2">Access</div>
        {!SUPABASE_URL || !SUPABASE_ANON_KEY ? (
          <div class="muted" style="margin-top:12px;">
            Supabase is not configured. Add `PUBLIC_SUPABASE_URL` and `PUBLIC_SUPABASE_ANON_KEY` to `.env` and restart `npm run dev`.
          </div>
        ) : (
          <form class="auth" data-auth-form novalidate>
            <div class="tabs" role="tablist" aria-label="Auth">
              <button class="tab is-on" type="button" data-tab="signin" role="tab" aria-selected="true">Sign in</button>
              <button class="tab" type="button" data-tab="signup" role="tab" aria-selected="false">Sign up</button>
            </div>

            <div class="welcome" data-auth-welcome hidden aria-live="polite" role="status">
              <div class="welcome__title" data-auth-welcome-title>—</div>
              <div class="welcome__sub muted small" data-auth-welcome-sub>—</div>
            </div>

            <div class="muted small" style="margin-top:10px;" data-auth-status aria-live="polite">—</div>

            <label class="field" style="margin-top:12px;">
              <span class="label">Email</span>
              <input class="input" name="email" type="email" autocomplete="email" required />
              <span class="err" aria-live="polite"></span>
            </label>

            <label class="field" style="margin-top:12px;" data-auth-username-wrap hidden>
              <span class="label">Username</span>
              <input class="input" name="username" type="text" autocomplete="username" minlength="2" maxlength="24" />
              <span class="err" aria-live="polite"></span>
            </label>

            <label class="field" style="margin-top:12px;">
              <span class="label">Password</span>
              <input class="input" name="password" type="password" autocomplete="current-password" required minlength="8" />
              <span class="err" aria-live="polite"></span>
            </label>

            <div class="actions" style="margin-top:14px;">
              <button class="btn btn-primary" type="submit" data-auth-submit>Continue</button>
              <button class="btn" type="button" data-auth-logout hidden>Sign out</button>
              <button class="btn" type="button" data-auth-whatsapp hidden>Send everything to WhatsApp</button>
            </div>

            <div class="muted small" style="margin-top:12px;">
              By continuing, we store a session on this device. If you prefer not to create an account, use the guided brief and send it on WhatsApp.
            </div>
          </form>
        )}
      </div>
    </div>
  </section>

  <style>
    .cta{ display:flex; gap:10px; flex-wrap:wrap; }
    .small{ font-size: 13px; }
    .tabs{ display:flex; gap:10px; flex-wrap:wrap; }
    .tab{
      border-radius: 999px;
      padding: 10px 12px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.03);
      cursor:pointer;
    }
    .tab.is-on{
      border-color: rgba(139,92,255,.34);
      background: linear-gradient(180deg, rgba(139,92,255,.14), rgba(255,255,255,.03));
      box-shadow: var(--glow);
    }
    .field{ display:grid; gap:8px; }
    .label{ font-size: 13px; color: rgba(237,237,243,.82); }
    .input{
      width:100%;
      padding: 12px 12px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .err{ font-size: 12px; color: rgba(255,140,140,.92); min-height: 14px; }
    .field.hasErr .input{ border-color: rgba(255,140,140,.55); }
    .actions{ display:flex; gap:10px; flex-wrap:wrap; }
    .welcome{
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.04);
      padding: 12px 12px;
      margin-top: 12px;
      animation: welcomeIn .35s ease-out both;
    }
    .welcome__title{ font-weight: 600; }
    .welcome__sub{ margin-top: 4px; }
    @keyframes welcomeIn{
      from{ opacity: 0; transform: translateY(6px); }
      to{ opacity: 1; transform: translateY(0); }
    }
  </style>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    (function(){
      const form = document.querySelector("[data-auth-form]");
      if(!form) return;

      const AUTH_KEY = "vexora_auth_v1";
      const tabs = Array.from(form.querySelectorAll("[data-tab]"));
      const status = form.querySelector("[data-auth-status]");
      const welcome = form.querySelector("[data-auth-welcome]");
      const welcomeTitle = form.querySelector("[data-auth-welcome-title]");
      const welcomeSub = form.querySelector("[data-auth-welcome-sub]");
      const usernameWrap = form.querySelector("[data-auth-username-wrap]");
      const btnLogout = form.querySelector("[data-auth-logout]");
      const btnWhatsApp = form.querySelector("[data-auth-whatsapp]");

      let mode = "signin";

      function setStatus(msg){
        if(status) status.textContent = msg || "—";
      }

      function showWelcome(title, sub){
        if(!welcome) return;
        if(welcomeTitle) welcomeTitle.textContent = title || "—";
        if(welcomeSub) welcomeSub.textContent = sub || "—";
        welcome.hidden = false;
        try{
          welcome.style.animation = "none";
          // retrigger animation
          // eslint-disable-next-line no-unused-expressions
          welcome.offsetHeight;
          welcome.style.animation = "";
        }catch{}
      }

      function hideWelcome(){
        if(welcome) welcome.hidden = true;
      }

      function setMode(next){
        mode = next === "signup" ? "signup" : "signin";
        tabs.forEach((b) => {
          const on = b.getAttribute("data-tab") === mode;
          b.classList.toggle("is-on", on);
          b.setAttribute("aria-selected", on ? "true" : "false");
        });
        const pw = form.querySelector('input[name="password"]');
        if(pw) pw.setAttribute("autocomplete", mode === "signin" ? "current-password" : "new-password");
        if(usernameWrap) usernameWrap.hidden = mode !== "signup";
        setStatus(mode === "signin" ? "Sign in to save and send your info." : "Create an account (email + password + username).");
      }

      function getField(name){ return form.querySelector(`[name="${name}"]`); }
      function setErr(field, msg){
        const wrap = field?.closest?.(".field");
        if(!wrap) return;
        const err = wrap.querySelector(".err");
        if(err) err.textContent = msg || "";
        wrap.classList.toggle("hasErr", Boolean(msg));
      }

      function clearErrs(){
        for(const w of Array.from(form.querySelectorAll(".field"))){
          w.classList.remove("hasErr");
          const e = w.querySelector(".err");
          if(e) e.textContent = "";
        }
      }

      function readDraft(key){
        try{
          const raw = window.localStorage.getItem(key);
          return raw ? JSON.parse(raw) : null;
        }catch{ return null; }
      }

      function getAllInfo(){
        const locale = document.body?.dataset?.locale || "en";
        const brief = readDraft(`vexora_brief_v1_${locale}`) || null;
        const quote = readDraft("vexora_cotizador_v1") || null;
        const utm = (window.vexoraGetUTMs && typeof window.vexoraGetUTMs === "function") ? window.vexoraGetUTMs() : {};
        const auth = readDraft(AUTH_KEY) || null;
        return { brief, quote, utm, auth };
      }

      function buildWhatsAppText(){
        const info = getAllInfo();
        const lines = [];
        lines.push("Hi Vexora, here is my info:");
        if(info.auth?.email) lines.push(`Account: ${info.auth.email}`);
        if(info.auth?.username) lines.push(`Username: ${info.auth.username}`);

        if(info.quote){
          lines.push("— Express quote —");
          if(info.quote.service) lines.push(`Service: ${info.quote.service}`);
          if(info.quote.scope) lines.push(`Scope: ${info.quote.scope}`);
          if(info.quote.urgency) lines.push(`Urgency: ${info.quote.urgency}`);
          if(info.quote.deadline) lines.push(`Deadline: ${info.quote.deadline}`);
          if(info.quote.budget) lines.push(`Budget: ${info.quote.budget}`);
          if(Array.isArray(info.quote.integrations) && info.quote.integrations.length) lines.push(`Integrations: ${info.quote.integrations.join(", ")}`);
          if(Array.isArray(info.quote.extras) && info.quote.extras.length) lines.push(`Extras: ${info.quote.extras.join(", ")}`);
          if(info.quote.site) lines.push(`Site: ${info.quote.site}`);
          if(info.quote.note) lines.push(`Notes: ${info.quote.note}`);
          if(info.quote.package) lines.push(`Package: ${info.quote.package}`);
        }

        if(info.brief){
          lines.push("— Brief —");
          if(info.brief.name || info.brief.company) lines.push(`Name/Company: ${[info.brief.name, info.brief.company].filter(Boolean).join(" · ")}`);
          if(info.brief.email || info.brief.whatsapp) lines.push(`Contact: ${[info.brief.whatsapp && `WA: ${info.brief.whatsapp}`, info.brief.email && `Email: ${info.brief.email}`].filter(Boolean).join(" · ")}`);
          if(Array.isArray(info.brief.services) && info.brief.services.length) lines.push(`Service: ${info.brief.services.join(", ")}`);
          if(info.brief.objective) lines.push(`Goal: ${info.brief.objective}`);
          if(info.brief.deadline) lines.push(`Deadline: ${info.brief.deadline}`);
          if(info.brief.budget) lines.push(`Budget: ${info.brief.budget}`);
          const links = [info.brief.link_site && `Site: ${info.brief.link_site}`, info.brief.link_discord && `Discord: ${info.brief.link_discord}`, info.brief.link_other && `Other: ${info.brief.link_other}`].filter(Boolean).join(" · ");
          if(links) lines.push(`Links: ${links}`);
        }

        const hasUtm = Boolean(info.utm?.utm_source || info.utm?.utm_campaign);
        lines.push(hasUtm ? `Source: ${(info.utm.utm_source || "—")}/${(info.utm.utm_campaign || "—")}` : "Source: (no UTMs)");
        return lines.join("\\n");
      }

      function openWhatsApp(){
        const txt = buildWhatsAppText();
        const url = `https://wa.me/522203309762?text=${encodeURIComponent(txt)}`;
        window.open(url, "_blank", "noopener,noreferrer");
      }

      function normalizeUsername(v){
        const raw = String(v || "").trim();
        const safe = raw.replace(/[^\w.-]/g, "");
        return safe.slice(0, 24);
      }

      function getDisplayName(sess){
        return (sess?.username || "").trim() || (sess?.email || "").trim() || "—";
      }

      function saveSession(session){
        try{ window.localStorage.setItem(AUTH_KEY, JSON.stringify(session)); }catch{}
        try{ window.vexoraTrack?.("auth_login", { provider: "supabase" }); }catch{}
      }

      function loadSession(){
        try{
          const raw = window.localStorage.getItem(AUTH_KEY);
          return raw ? JSON.parse(raw) : null;
        }catch{ return null; }
      }

      function clearSession(){
        try{ window.localStorage.removeItem(AUTH_KEY); }catch{}
        try{ window.vexoraTrack?.("auth_logout", { provider: "supabase" }); }catch{}
      }

      async function supabaseFetch(path, opts){
        const url = `${SUPABASE_URL}${path}`;
        const headers = Object.assign(
          {
            apikey: SUPABASE_ANON_KEY,
            authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            "content-type": "application/json"
          },
          (opts && opts.headers) || {}
        );
        const res = await fetch(url, Object.assign({}, opts, { headers }));
        const data = await res.json().catch(() => ({}));
        if(!res.ok) throw new Error(data?.msg || data?.error_description || data?.error || "Auth error");
        return data;
      }

      async function signUp(email, password, username){
        const data = username ? { username } : {};
        return supabaseFetch("/auth/v1/signup", { method:"POST", body: JSON.stringify({ email, password, data }) });
      }

      async function signIn(email, password){
        return supabaseFetch("/auth/v1/token?grant_type=password", { method:"POST", body: JSON.stringify({ email, password }) });
      }

      async function refreshSession(refresh_token){
        return supabaseFetch("/auth/v1/token?grant_type=refresh_token", { method:"POST", body: JSON.stringify({ refresh_token }) });
      }

      async function getUser(access_token){
        return supabaseFetch("/auth/v1/user", { method:"GET", headers: { authorization: `Bearer ${access_token}` } });
      }

      async function updateUser(access_token, data){
        return supabaseFetch("/auth/v1/user", { method:"PUT", headers: { authorization: `Bearer ${access_token}` }, body: JSON.stringify({ data }) });
      }

      async function logout(){
        const sess = loadSession();
        if(sess?.access_token){
          try{
            await supabaseFetch("/auth/v1/logout", {
              method:"POST",
              headers: { authorization: `Bearer ${sess.access_token}` }
            });
          }catch{}
        }
        clearSession();
      }

      function upsertSessionFromAuthResponse(email, out, fallbackUsername){
        const user = out?.user || out?.session?.user || null;
        const username = String(user?.user_metadata?.username || fallbackUsername || "").trim();
        const access_token = out?.access_token || out?.session?.access_token || "";
        const refresh_token = out?.refresh_token || out?.session?.refresh_token || "";
        const expires_in = Number(out?.expires_in || out?.session?.expires_in || 0);
        const expires_at = expires_in ? Math.floor(Date.now() / 1000) + expires_in : undefined;
        const user_id = user?.id || "";
        saveSession({ email, username, user_id, access_token, refresh_token, expires_at });
        return loadSession();
      }

      async function ensureFreshSession(){
        const sess = loadSession();
        if(!sess?.refresh_token) return sess;
        const exp = Number(sess?.expires_at || 0);
        const now = Math.floor(Date.now() / 1000);
        const shouldRefresh = Boolean(exp && now >= (exp - 30));
        if(!shouldRefresh) return sess;
        try{
          const out = await refreshSession(sess.refresh_token);
          upsertSessionFromAuthResponse(sess.email || "", out, sess.username || "");
          return loadSession();
        }catch{
          clearSession();
          return null;
        }
      }

      async function updateUI(){
        const sess = await ensureFreshSession();
        const logged = Boolean(sess?.access_token && sess?.email);
        btnLogout.hidden = !logged;
        btnWhatsApp.hidden = false;
        const emailField = getField("email");
        const pwField = getField("password");
        const usernameField = getField("username");
        if(logged){
          if(usernameWrap) usernameWrap.hidden = false;
          if(emailField) emailField.value = sess.email || "";
          if(usernameField) usernameField.value = sess.username || "";
          if(pwField) pwField.value = "********";
          if(pwField) pwField.setAttribute("disabled","true");
          if(emailField) emailField.setAttribute("disabled","true");
          setStatus(`Signed in: ${sess.email}`);
        } else {
          if(usernameWrap) usernameWrap.hidden = mode !== "signup";
          if(pwField) pwField.removeAttribute("disabled");
          if(emailField) emailField.removeAttribute("disabled");
          if(pwField && pwField.value === "********") pwField.value = "";
          if(usernameField) usernameField.value = "";
          hideWelcome();
          setStatus(mode === "signin" ? "Sign in to save and send your info." : "Create an account (email + password + username).");
        }
      }

      tabs.forEach((b) => b.addEventListener("click", () => setMode(b.getAttribute("data-tab"))));
      btnLogout.addEventListener("click", async () => {
        setStatus("Signing out…");
        await logout();
        await updateUI();
      });
      btnWhatsApp.addEventListener("click", () => openWhatsApp());

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearErrs();
        const email = String(getField("email")?.value || "").trim();
        const password = String(getField("password")?.value || "");
        const username = normalizeUsername(getField("username")?.value || "");
        if(!email){ setErr(getField("email"), "Required"); return; }
        if(!password || password.length < 8){ setErr(getField("password"), "Min 8 characters"); return; }
        if(mode === "signup"){
          if(!username || username.length < 2){ setErr(getField("username"), "Required (2+ chars)"); return; }
        }
        setStatus(mode === "signin" ? "Signing in…" : "Creating account…");
        try{
          if(mode === "signup"){
            const out = await signUp(email, password, username);
            const access = out?.session?.access_token || "";
            if(access){
              upsertSessionFromAuthResponse(email, out, username);
              showWelcome(`Welcome, ${getDisplayName(loadSession())}.`, "Ready: you can send your summary via WhatsApp.");
              setStatus("Account created. Signed in.");
            } else {
              hideWelcome();
              setStatus("Account created. Check your email to confirm (if enabled).");
            }
          } else {
            const out = await signIn(email, password);
            upsertSessionFromAuthResponse(email, out, "");
            showWelcome(`Welcome back, ${getDisplayName(loadSession())}.`, "Session saved on this device.");
            setStatus("Signed in.");
          }
          await updateUI();
        } catch(err){
          hideWelcome();
          setStatus(`Error: ${err?.message || "Auth error"}`);
        }
      });

      setMode("signin");
      updateUI();

      const usernameField = getField("username");
      usernameField?.addEventListener?.("keydown", async (e) => {
        if(e.key !== "Enter") return;
        if(mode === "signup") return;
        const sess = loadSession();
        if(!sess?.access_token) return;
        e.preventDefault();
        clearErrs();
        const next = normalizeUsername(usernameField.value || "");
        if(!next || next.length < 2){ setErr(usernameField, "Min 2 characters"); return; }
        setStatus("Updating username…");
        try{
          const out = await updateUser(sess.access_token, { username: next });
          saveSession({ ...sess, username: String(out?.user_metadata?.username || next).trim() || next });
          showWelcome(`Done, ${getDisplayName(loadSession())}.`, "Username updated.");
          setStatus("Updated.");
        } catch(err){
          setStatus(`Error: ${err?.message || "Auth error"}`);
        }
      });
    })();
  </script>
</BaseLayout>

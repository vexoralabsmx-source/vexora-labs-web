---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND } from "@/lib/constants";
import { getWhatsAppLink } from "@/lib/whatsapp";
---
<BaseLayout
  page="minecraft"
  title={`Minecraft infra — ${BRAND}`}
  description="Setup de servidores Minecraft: plugins, optimizacion, seguridad, backups y runbooks. Estabilidad primero, features despues."
  canonicalPath="/minecraft/"
>
  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <div class="pill">Minecraft</div>
        <h1 class="h1" style="margin-top:14px;">Estabilidad antes que features.</h1>
        <p class="muted" style="margin:12px 0 0; max-width:72ch;">
          Un servidor que se cae o lagea es una fuga constante de confianza. Construimos infraestructura operable:
          performance, seguridad basica, backups y un proceso de actualizaciones con rollback.
        </p>
        <div class="cta" data-reveal>
          <a class="btn btn-primary" href={getWhatsAppLink("minecraft")} target="_blank" rel="noreferrer">Cotizar por WhatsApp</a>
          <a class="btn" href="/precios/">Ver paquetes</a>
          <a class="btn" href="/seguridad-etica/">Seguridad y etica</a>
        </div>
        <div class="disclaimer muted small" data-reveal>
          Nota: No hacemos dupe glitches, cheats, exploits ni accesos no autorizados. Solo configuracion, hardening basico y operacion legitima.
        </div>
      </div>

      <aside class="glass card" data-reveal>
        <div class="h3">Que entregamos</div>
        <ul class="list">
          <li>Setup del servidor y estructura de carpetas limpia.</li>
          <li>Configuracion de plugins (segun objetivo).</li>
          <li>Optimización (tuning) para picos y estabilidad.</li>
          <li>Seguridad basica: permisos, whitelist/banlists, limites y alertas.</li>
          <li>Backups automatizados + prueba de restauracion.</li>
          <li>Runbook: como actualizar, monitorear y responder incidentes.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container glass card" data-reveal>
      <div class="sectionHead">
        <h2 class="h2">Arquitectura (engineering vibes)</h2>
        <a class="btn btn-primary" href={getWhatsAppLink("minecraft")} target="_blank" rel="noreferrer">Cotizar por WhatsApp</a>
      </div>
      <div class="grid3">
        <article class="mod" data-reveal>
          <div class="mod__t">Performance</div>
          <p class="muted">Tuning de ticks, view-distance, entidades y ajustes por escenario.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Seguridad basica</div>
          <p class="muted">Permisos, accesos, proteccion anti-griefing (segun reglas) y buenas practicas.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Backups + rollback</div>
          <p class="muted">Backups programados, retencion, verificacion y restauracion de prueba.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Operación</div>
          <p class="muted">Checklist de actualizaciones, ventanas, monitoreo y respuestas.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Plugins y UX</div>
          <p class="muted">Lobby, permisos, economia (si aplica) y experiencia coherente.</p>
        </article>
        <article class="mod" data-reveal>
          <div class="mod__t">Documentacion</div>
          <p class="muted">Lo que queda sin documentar, se vuelve deuda. Entregamos guias claras.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="glass card" data-reveal>
        <h2 class="h2">Proceso recomendado</h2>
        <ol class="steps">
          <li><span class="n">1</span><div><div class="t">Objetivo y reglas</div><div class="muted">Survival, Skyblock, roleplay, minijuegos, etc. Todo cambia con el objetivo.</div></div></li>
          <li><span class="n">2</span><div><div class="t">Baseline y hardening</div><div class="muted">Permisos, accesos, limites, backups y monitoreo minimo.</div></div></li>
          <li><span class="n">3</span><div><div class="t">Plugins + tuning</div><div class="muted">Solo lo necesario, medido y con plan de rollback.</div></div></li>
          <li><span class="n">4</span><div><div class="t">QA en picos</div><div class="muted">Pruebas controladas: performance, permisos y escenarios comunes.</div></div></li>
        </ol>
      </div>
      <div class="glass card" data-reveal>
        <h2 class="h2">Soporte y garantia</h2>
        <ul class="list">
          <li>Ajustes post-entrega (7 dias habiles) para tuning y permisos.</li>
          <li>Si se agrega un plugin nuevo, sugerimos prueba en staging antes de prod.</li>
          <li>Garantias realistas: estabilidad mejora con operacion, no con promesas magicas.</li>
        </ul>
        <div class="ctaBox">
          <div>
            <div class="ctaBox__t">Brief rapido</div>
            <div class="muted small">Version, hosting, jugadores pico, modo y plugins deseados.</div>
          </div>
          <a class="btn btn-primary" href={getWhatsAppLink("minecraft")} target="_blank" rel="noreferrer">Escribir</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top: 16px; }
    .small{ font-size: 13px; }
    .disclaimer{ margin-top: 14px; }
    .list{ margin: 14px 0 0; padding-left: 18px; color: rgba(237,237,243,.84); }
    .list li{ margin: 9px 0; }
    .sectionHead{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom: 12px; }
    .grid3{ display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; }
    .mod{ border-radius: 20px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); padding: 16px; }
    .mod__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .steps{ margin: 14px 0 0; padding:0; list-style:none; display:grid; gap:10px; }
    .steps li{ display:grid; grid-template-columns: 34px 1fr; gap:12px; padding: 12px; border-radius: 18px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); }
    .n{ width:34px; height:34px; border-radius: 14px; display:grid; place-items:center; border:1px solid rgba(255,255,255,.12); background: linear-gradient(180deg, rgba(139,92,255,.18), rgba(255,255,255,.03)); font-family: var(--font-display); font-weight:700; }
    .t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    .ctaBox{ margin-top: 16px; padding: 14px; border-radius: 18px; border:1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.03); display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
    .ctaBox__t{ font-family: var(--font-display); font-weight:650; letter-spacing:-.02em; }
    @media (max-width: 980px){
      .grid3{ grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>


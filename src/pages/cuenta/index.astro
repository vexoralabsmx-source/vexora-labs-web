---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRAND } from "@/lib/constants";

const SUPABASE_URL = (import.meta.env.PUBLIC_SUPABASE_URL ?? "").trim();
const SUPABASE_ANON_KEY = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "").trim();
const SITE_URL = (import.meta.env.PUBLIC_SITE_URL ?? "https://vexoralabs.shop").replace(/\/$/, "");
---

<BaseLayout
  page="cuenta"
  title={`Afiliados — ${BRAND}`}
  description="Panel de afiliados de Vexora Labs: comparte tu código, registra ventas y revisa comisiones."
  canonicalPath="/cuenta/"
>
  <section class="affiliatePage">
    <div class="affiliateShell">
      <header class="affiliateHero">
        <div>
          <span class="eyebrow">Vexora Labs Afiliados</span>
          <h1>Gana comisiones recomendando servicios digitales.</h1>
          <p>
            Comparte tu link, registra ventas con invoice interno y deja que el equipo revise cada operación antes de liberar comisión.
          </p>
        </div>
        <div class="heroStats" aria-label="Servicios elegibles">
          <span>Páginas web</span>
          <span>Bots de Discord</span>
          <span>Automatizaciones</span>
          <span>Minecraft</span>
          <span>UI/UX</span>
          <span>Soluciones con IA</span>
        </div>
      </header>

      {!SUPABASE_URL || !SUPABASE_ANON_KEY ? (
        <div class="panel warning">
          Supabase no está configurado. Agrega `PUBLIC_SUPABASE_URL` y `PUBLIC_SUPABASE_ANON_KEY` en `.env`.
        </div>
      ) : (
        <>
          <section class="grid two">
            <form class="panel authPanel" data-auth-form>
              <div class="panelHead">
                <div>
                  <span class="eyebrow">Acceso</span>
                  <h2>Tu cuenta</h2>
                </div>
                <div class="segmented" role="tablist">
                  <button type="button" class="isActive" data-auth-mode="signin">Entrar</button>
                  <button type="button" data-auth-mode="signup">Registro</button>
                </div>
              </div>

              <p class="status" data-auth-status>Detectando código de referido...</p>

              <label class="field">
                <span>Email</span>
                <input name="email" type="email" autocomplete="email" required />
              </label>

              <label class="field" data-username-wrap hidden>
                <span>Nombre de usuario</span>
                <input name="username" type="text" autocomplete="username" maxlength="24" />
              </label>

              <label class="field" data-invite-wrap>
                <span>Código de invitación</span>
                <input name="invite_code" type="text" autocomplete="off" maxlength="32" placeholder="VEX-MIKE-4821" />
              </label>

              <label class="field">
                <span>Contraseña</span>
                <input name="password" type="password" autocomplete="current-password" minlength="8" required />
              </label>

              <div class="actions">
                <button class="btnPrimary" type="submit" data-auth-submit>Continuar</button>
                <button class="btnGhost" type="button" data-logout hidden>Cerrar sesión</button>
              </div>
            </form>

            <aside class="panel">
              <div class="panelHead">
                <div>
                  <span class="eyebrow">Estado</span>
                  <h2>Reglas rápidas</h2>
                </div>
              </div>
              <ul class="rules">
                <li>Tu referido queda ligado cuando inicia sesión o se registra con tu código.</li>
                <li>Una venta reportada queda en <strong>pendiente</strong>; no crea comisión.</li>
                <li>Solo un admin puede aprobar, rechazar o marcar comisiones como pagadas.</li>
                <li>Las notificaciones a Discord salen desde backend, nunca desde el navegador.</li>
              </ul>
            </aside>
          </section>

          <section class="dashboard" data-dashboard hidden>
            <div class="grid four">
              <article class="metric">
                <span>Saldo pendiente</span>
                <strong data-balance>$0 MXN</strong>
              </article>
              <article class="metric">
                <span>Histórico ganado</span>
                <strong data-lifetime>$0 MXN</strong>
              </article>
              <article class="metric">
                <span>Referidos</span>
                <strong data-referrals-count>0</strong>
              </article>
              <article class="metric">
                <span>Ventas pendientes</span>
                <strong data-orders-pending>0</strong>
              </article>
            </div>

            <section class="grid two">
              <div class="panel">
                <div class="panelHead">
                  <div>
                    <span class="eyebrow">Compartir</span>
                    <h2>Tu link de afiliado</h2>
                  </div>
                  <span class="badge active" data-profile-status>Activo</span>
                </div>

                <label class="field">
                  <span>Código</span>
                  <div class="copyRow">
                    <input data-invite-code readonly />
                    <button class="btnGhost" type="button" data-copy-code>Copiar</button>
                  </div>
                </label>

                <label class="field">
                  <span>Link</span>
                  <div class="copyRow">
                    <input data-invite-link readonly />
                    <button class="btnGhost" type="button" data-copy-link>Copiar</button>
                  </div>
                </label>

                <div class="grid two compact">
                  <label class="field">
                    <span>Email para pagos</span>
                    <input data-payout-email type="email" placeholder="pagos@dominio.com" />
                  </label>
                  <label class="field">
                    <span>Método de pago</span>
                    <input data-payout-method type="text" placeholder="Transferencia / PayPal" />
                  </label>
                </div>
                <button class="btnPrimary" type="button" data-save-payout>Guardar datos de pago</button>
                <p class="status" data-affiliate-status>Dashboard listo.</p>
              </div>

              <form class="panel" data-order-form>
                <div class="panelHead">
                  <div>
                    <span class="eyebrow">Venta referida</span>
                    <h2>Reportar venta</h2>
                  </div>
                  <button class="btnGhost" type="button" data-generate-invoice>Generar invoice</button>
                </div>

                <div class="grid two compact">
                  <label class="field">
                    <span>Invoice ID</span>
                    <input name="invoice_id" type="text" placeholder="VEX-20260531-0001" required />
                  </label>
                  <label class="field">
                    <span>Monto MXN</span>
                    <input name="amount_mxn" type="number" min="1" step="0.01" required />
                  </label>
                </div>

                <label class="field">
                  <span>Servicio vendido</span>
                  <select name="service_name" required>
                    <option value="">Selecciona servicio</option>
                    <option>Páginas web</option>
                    <option>Bots de Discord</option>
                    <option>Automatizaciones</option>
                    <option>Servidores de Minecraft</option>
                    <option>UI/UX</option>
                    <option>Soluciones con IA</option>
                    <option>Productos digitales</option>
                  </select>
                </label>

                <div class="grid two compact">
                  <label class="field">
                    <span>Cliente</span>
                    <input name="customer_name" type="text" />
                  </label>
                  <label class="field">
                    <span>Contacto</span>
                    <input name="customer_contact" type="text" placeholder="WhatsApp o usuario" />
                  </label>
                </div>

                <div class="grid two compact">
                  <label class="field">
                    <span>Email del cliente</span>
                    <input name="customer_email" type="email" />
                  </label>
                  <label class="field">
                    <span>Método de pago</span>
                    <input name="payment_method" type="text" placeholder="Transferencia" />
                  </label>
                </div>

                <label class="field">
                  <span>Comprobante URL opcional</span>
                  <input name="proof_url" type="url" />
                </label>

                <label class="field">
                  <span>Notas</span>
                  <textarea name="notes" rows="3"></textarea>
                </label>

                <button class="btnPrimary" type="submit">Enviar a revisión</button>
                <p class="status" data-order-status>La comisión se calcula, pero no se crea hasta que admin apruebe.</p>
              </form>
            </section>

            <section class="grid three">
              <div class="panel">
                <div class="panelHead"><h2>Referidos</h2></div>
                <ul class="list" data-referrals></ul>
              </div>
              <div class="panel">
                <div class="panelHead"><h2>Órdenes recientes</h2></div>
                <ul class="list" data-orders></ul>
              </div>
              <div class="panel">
                <div class="panelHead"><h2>Comisiones</h2></div>
                <ul class="list" data-commissions></ul>
              </div>
            </section>
          </section>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, SITE_URL }}>
  (() => {
    const AUTH_KEY = "vexora_auth_v2";
    const PENDING_INVITE_KEY = "vexora_pending_invite_v2";
    let mode = "signin";
    let profile = null;

    const $ = (s, root = document) => root.querySelector(s);
    const $$ = (s, root = document) => Array.from(root.querySelectorAll(s));

    const authForm = $("[data-auth-form]");
    const dashboard = $("[data-dashboard]");
    const authStatus = $("[data-auth-status]");
    const affiliateStatus = $("[data-affiliate-status]");
    const orderStatus = $("[data-order-status]");

    function setText(el, text){ if(el) el.textContent = text; }
    function money(cents, currency = "MXN"){
      return new Intl.NumberFormat("es-MX", { style: "currency", currency }).format(Number(cents || 0) / 100);
    }
    function date(v){
      if(!v) return "—";
      const d = new Date(v);
      return Number.isNaN(d.getTime()) ? "—" : new Intl.DateTimeFormat("es-MX", { dateStyle:"short", timeStyle:"short" }).format(d);
    }
    function normalizeInvite(v){ return String(v || "").trim().toUpperCase().replace(/[^A-Z0-9-]/g, "").slice(0, 32); }
    function normalizeInvoice(v){ return String(v || "").trim().toUpperCase().replace(/[^A-Z0-9-]/g, "").slice(0, 24); }
    function session(){ try { return JSON.parse(localStorage.getItem(AUTH_KEY) || "null"); } catch { return null; } }
    function saveSession(s){ localStorage.setItem(AUTH_KEY, JSON.stringify(s)); }
    function clearSession(){ localStorage.removeItem(AUTH_KEY); }
    function savePendingInvite(code){ const safe = normalizeInvite(code); if(safe) localStorage.setItem(PENDING_INVITE_KEY, safe); }
    function readPendingInvite(){ return normalizeInvite(localStorage.getItem(PENDING_INVITE_KEY) || ""); }
    function clearPendingInvite(){ localStorage.removeItem(PENDING_INVITE_KEY); }

    async function api(path, opts = {}){
      const headers = Object.assign({
        apikey: SUPABASE_ANON_KEY,
        authorization: `Bearer ${SUPABASE_ANON_KEY}`,
        "content-type": "application/json"
      }, opts.headers || {});
      const res = await fetch(`${SUPABASE_URL}${path}`, Object.assign({}, opts, { headers }));
      const data = await res.json().catch(() => null);
      if(!res.ok){
        throw new Error(data?.message || data?.msg || data?.error_description || data?.error || `Error ${res.status}`);
      }
      return data;
    }
    function authHeaders(){ return { authorization: `Bearer ${session()?.access_token || ""}` }; }
    async function rpc(name, body = {}){ return api(`/rest/v1/rpc/${name}`, { method:"POST", headers: authHeaders(), body: JSON.stringify(body) }); }
    async function signIn(email, password){ return api("/auth/v1/token?grant_type=password", { method:"POST", body: JSON.stringify({ email, password }) }); }
    async function signUp(email, password, username){ return api("/auth/v1/signup", { method:"POST", body: JSON.stringify({ email, password, data: { username } }) }); }
    async function refreshSession(){
      const s = session();
      if(!s?.refresh_token) return s;
      const exp = Number(s.expires_at || 0);
      const now = Math.floor(Date.now() / 1000);
      if(exp && now < exp - 45) return s;
      try {
        const out = await api("/auth/v1/token?grant_type=refresh_token", { method:"POST", body: JSON.stringify({ refresh_token: s.refresh_token }) });
        saveAuth(out, s.email, s.username);
        return session();
      } catch {
        clearSession();
        return null;
      }
    }
    function saveAuth(out, email, fallbackUsername = ""){
      const user = out?.user || out?.session?.user || {};
      const access = out?.access_token || out?.session?.access_token || "";
      const refresh = out?.refresh_token || out?.session?.refresh_token || "";
      const expiresIn = Number(out?.expires_in || out?.session?.expires_in || 0);
      saveSession({
        user_id: user.id || "",
        email: user.email || email || "",
        username: user?.user_metadata?.username || fallbackUsername || "",
        access_token: access,
        refresh_token: refresh,
        expires_at: expiresIn ? Math.floor(Date.now() / 1000) + expiresIn : 0
      });
    }

    function captureInvite(){
      const url = new URL(window.location.href);
      const fromUrl = normalizeInvite(url.searchParams.get("ref"));
      if(fromUrl) savePendingInvite(fromUrl);
      const field = authForm?.elements?.invite_code;
      const pending = fromUrl || readPendingInvite();
      if(field && pending) field.value = pending;
      if(pending) setText(authStatus, `Código detectado: ${pending}. Inicia sesión para aplicarlo.`);
    }

    async function claimPendingInvite(){
      const code = normalizeInvite(authForm?.elements?.invite_code?.value || readPendingInvite());
      if(!code) return;
      try {
        await rpc("claim_referral_code", { p_invite_code: code });
        clearPendingInvite();
        if(authForm?.elements?.invite_code) authForm.elements.invite_code.value = "";
        setText(authStatus, `Código ${code} aplicado correctamente.`);
      } catch (err) {
        const msg = String(err?.message || "");
        if(/Self referral/i.test(msg)){
          clearPendingInvite();
          setText(authStatus, "No puedes usar tu propio código.");
        } else if(/already has an affiliate/i.test(msg) || /already assigned/i.test(msg)){
          clearPendingInvite();
          setText(authStatus, "Tu usuario ya tiene un afiliado asignado.");
        } else {
          setText(authStatus, `No se pudo aplicar el código: ${msg}`);
        }
      }
    }

    async function loadDashboard(){
      const s = await refreshSession();
      const logged = Boolean(s?.access_token && s?.user_id);
      $("[data-logout]").hidden = !logged;
      if(!dashboard) return;
      dashboard.hidden = !logged;
      if(!logged){
        setText(authStatus, "Inicia sesión para ver tu panel de afiliado.");
        return;
      }

      await rpc("ensure_affiliate_profile");
      await claimPendingInvite();

      const [profiles, referrals, orders, commissions] = await Promise.all([
        api("/rest/v1/affiliate_profiles?select=*&limit=1", { headers: authHeaders() }),
        api("/rest/v1/affiliate_referrals?select=*&order=created_at.desc&limit=20", { headers: authHeaders() }),
        api("/rest/v1/affiliate_orders?select=*&order=created_at.desc&limit=20", { headers: authHeaders() }),
        api("/rest/v1/affiliate_commissions?select=*&order=created_at.desc&limit=20", { headers: authHeaders() })
      ]);

      profile = Array.isArray(profiles) ? profiles[0] : profiles;
      if(!profile) throw new Error("No se pudo cargar perfil de afiliado");

      $("[data-invite-code]").value = profile.invite_code || "";
      $("[data-invite-link]").value = `${SITE_URL}/cuenta/?ref=${encodeURIComponent(profile.invite_code || "")}`;
      $("[data-payout-email]").value = profile.payout_email || s.email || "";
      $("[data-payout-method]").value = profile.payout_method || "";
      setText($("[data-balance]"), money(profile.referral_balance_cents));
      setText($("[data-lifetime]"), money(profile.lifetime_earned_cents));
      setText($("[data-referrals-count]"), String(referrals.length));
      setText($("[data-orders-pending]"), String(orders.filter((o) => o.status === "pending_review").length));
      const badge = $("[data-profile-status]");
      badge.className = `badge ${profile.status || "active"}`;
      badge.textContent = statusLabel(profile.status || "active");

      renderList("[data-referrals]", referrals, (x) => `${short(x.referred_user_id)} · ${statusLabel(x.status)} · ${date(x.created_at)}`);
      renderList("[data-orders]", orders, (x) => `${x.invoice_id} · ${money(x.amount_cents, x.currency)} · ${statusLabel(x.status)}`);
      renderList("[data-commissions]", commissions, (x) => `${x.invoice_id} · ${money(x.commission_cents, x.currency)} · ${statusLabel(x.status)}`);
      setText(affiliateStatus, "Dashboard actualizado.");
    }

    function renderList(selector, items, map){
      const list = $(selector);
      if(!list) return;
      list.innerHTML = "";
      if(!items.length){
        const li = document.createElement("li");
        li.textContent = "Sin movimientos todavía.";
        list.appendChild(li);
        return;
      }
      for(const item of items){
        const li = document.createElement("li");
        li.textContent = map(item);
        list.appendChild(li);
      }
    }
    function short(v){ const s = String(v || "—"); return s.length > 12 ? `${s.slice(0, 6)}...${s.slice(-4)}` : s; }
    function statusLabel(v){
      return ({
        pending_review: "Pendiente",
        approved: "Aprobada",
        rejected: "Rechazada",
        cancelled: "Cancelada",
        pending: "Pendiente de pago",
        paid: "Pagada",
        active: "Activo",
        suspended: "Suspendido",
        banned: "Baneado",
        registered: "Registrado",
        converted: "Convertido"
      })[String(v || "")] || v || "—";
    }
    async function copy(value){
      try { await navigator.clipboard.writeText(String(value || "")); return true; } catch { return false; }
    }

    $$("[data-auth-mode]").forEach((btn) => {
      btn.addEventListener("click", () => {
        mode = btn.dataset.authMode;
        $$("[data-auth-mode]").forEach((x) => x.classList.toggle("isActive", x === btn));
        $("[data-username-wrap]").hidden = mode !== "signup";
        $("[data-auth-submit]").textContent = mode === "signup" ? "Crear cuenta" : "Iniciar sesión";
      });
    });

    authForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const email = String(form.elements.email.value || "").trim();
      const password = String(form.elements.password.value || "");
      const username = String(form.elements.username?.value || "").trim();
      const invite = normalizeInvite(form.elements.invite_code?.value || "");
      if(invite) savePendingInvite(invite);
      setText(authStatus, mode === "signup" ? "Creando cuenta..." : "Iniciando sesión...");
      try {
        const out = mode === "signup" ? await signUp(email, password, username) : await signIn(email, password);
        if(out?.session || out?.access_token){
          saveAuth(out, email, username);
          await loadDashboard();
        } else {
          setText(authStatus, "Cuenta creada. Confirma tu email e inicia sesión para aplicar el código.");
        }
      } catch (err) {
        setText(authStatus, err?.message || "No se pudo continuar.");
      }
    });

    $("[data-logout]")?.addEventListener("click", () => {
      clearSession();
      dashboard.hidden = true;
      setText(authStatus, "Sesión cerrada.");
    });
    $("[data-copy-code]")?.addEventListener("click", async () => setText(affiliateStatus, await copy($("[data-invite-code]").value) ? "Código copiado." : "No se pudo copiar."));
    $("[data-copy-link]")?.addEventListener("click", async () => setText(affiliateStatus, await copy($("[data-invite-link]").value) ? "Link copiado." : "No se pudo copiar."));
    $("[data-save-payout]")?.addEventListener("click", async () => {
      const s = session();
      if(!s?.user_id) return;
      setText(affiliateStatus, "Guardando datos de pago...");
      try {
        await api(`/rest/v1/affiliate_profiles?user_id=eq.${encodeURIComponent(s.user_id)}`, {
          method:"PATCH",
          headers: Object.assign(authHeaders(), { Prefer:"return=minimal" }),
          body: JSON.stringify({
            payout_email: String($("[data-payout-email]").value || "").trim() || null,
            payout_method: String($("[data-payout-method]").value || "").trim() || null
          })
        });
        setText(affiliateStatus, "Datos de pago guardados.");
      } catch (err) {
        setText(affiliateStatus, err?.message || "No se pudo guardar.");
      }
    });
    $("[data-generate-invoice]")?.addEventListener("click", async () => {
      try {
        const invoice = await rpc("generate_invoice_id", {});
        $("[data-order-form]").elements.invoice_id.value = normalizeInvoice(invoice);
      } catch (err) {
        setText(orderStatus, err?.message || "No se pudo generar invoice.");
      }
    });
    $("[data-order-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if(!profile?.invite_code) return setText(orderStatus, "Carga tu perfil antes de reportar venta.");
      const form = new FormData(event.currentTarget);
      const amount = Number(String(form.get("amount_mxn") || "0").replace(",", "."));
      if(!Number.isFinite(amount) || amount <= 0) return setText(orderStatus, "Monto inválido.");
      setText(orderStatus, "Creando venta pendiente...");
      try {
        const out = await rpc("create_affiliate_order", {
          p_invite_code: profile.invite_code,
          p_invoice_id: normalizeInvoice(form.get("invoice_id")),
          p_customer_name: String(form.get("customer_name") || ""),
          p_customer_contact: String(form.get("customer_contact") || ""),
          p_customer_email: String(form.get("customer_email") || ""),
          p_service_name: String(form.get("service_name") || ""),
          p_amount_cents: Math.round(amount * 100),
          p_currency: "MXN",
          p_payment_method: String(form.get("payment_method") || ""),
          p_proof_url: String(form.get("proof_url") || ""),
          p_notes: String(form.get("notes") || "")
        });
        const notify = await fetch("/api/affiliate/order-created", {
          method: "POST",
          headers: { "content-type":"application/json", authorization: `Bearer ${session()?.access_token || ""}` },
          body: JSON.stringify({ order_id: out?.order_id })
        }).then((r) => r.json()).catch(() => ({ notification_sent:false }));
        event.currentTarget.reset();
        setText(orderStatus, notify?.notification_sent ? "Venta enviada a revisión y Discord notificado." : "Venta guardada. Discord no confirmó notificación.");
        await loadDashboard();
      } catch (err) {
        setText(orderStatus, err?.message || "No se pudo crear la venta.");
      }
    });

    captureInvite();
    loadDashboard().catch((err) => setText(authStatus, err?.message || "No se pudo cargar la cuenta."));
  })();
</script>

<style>
  .affiliatePage{background:#050505;color:#fff;min-height:100vh;padding:56px 0}
  .affiliateShell{width:min(1180px,calc(100% - 32px));margin:0 auto}
  .affiliateHero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr);gap:24px;align-items:end;margin-bottom:24px}
  .affiliateHero h1{font-size:clamp(2rem,5vw,4.8rem);line-height:.98;margin:10px 0 0;letter-spacing:0}
  .affiliateHero p{color:#a1a1aa;max-width:760px;font-size:1.05rem;line-height:1.7}
  .eyebrow{font-size:.76rem;text-transform:uppercase;color:#38bdf8;letter-spacing:.12em;font-weight:700}
  .heroStats{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}
  .heroStats span,.badge{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);border-radius:999px;padding:7px 10px;color:#d4d4d8;font-size:.82rem}
  .grid{display:grid;gap:16px}
  .two{grid-template-columns:repeat(2,minmax(0,1fr))}
  .three{grid-template-columns:repeat(3,minmax(0,1fr))}
  .four{grid-template-columns:repeat(4,minmax(0,1fr))}
  .compact{gap:12px}
